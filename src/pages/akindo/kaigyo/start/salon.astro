---
import KaigyoLayout from '../../../../layouts/KaigyoLayout.astro';
import BusinessFlow from '../../../../components/akindo/kaigyo/BusinessFlow.astro';
import ToolGlyph from '../../../../components/akindo/kaigyo/ToolGlyph.astro';
import { salonSections } from '../../../../data/akindo/salon';
import { toolCategories } from '../../../../data/akindo/tools';
const phases = [
  { id: 'salon-foundation', title: '土台を決める', caption: 'メニュー・場所・必要な手続き', description: 'まずは、どんなサロンを、どこで開くか。お金をかける前に決めておきたいことです。', start: 0, end: 3 },
  { id: 'salon-welcome', title: '迎える準備をする', caption: 'お金の管理・支払い・予約', description: '最初のお客さまを迎えられるように、予約から会計までの流れを整えます。', start: 3, end: 6 },
  { id: 'salon-discovery', title: '窓口をつなぐ', caption: 'LINE・Google・SNS・案内ページ', description: 'どの窓口から見つけても、同じメニューと予約先へ。まずは基本の案内をそろえましょう。', start: 6, end: 10 },
  { id: 'salon-continuity', title: '開業から、その先へ', caption: '顧客管理・告知・再来店', description: '開業を知らせて、次のご縁につなげる。無理なく続けられる運用を作ります。', start: 10, end: 13 },
];
const sectionGlyphs: Record<string, string> = { essentials: 'shop', concept: 'shop', permissions: 'checklist', announcement: 'instagram' };
---
<KaigyoLayout title="ひとりサロン開業準備ガイド｜予約・LINE・集客｜AKINDO Lab" description="美容、ネイル、エステ、リラクゼーション、まつげ、自宅サロンなど、ひとりサロンの開業準備を整理。許認可の確認から会計・予約・LINE・集客・再来店まで、次にやることが分かります。" pageTitle="ひとりの商いを、無理なく続くサロンに。" pageTitleParts={["ひとりの商いを、", "無理なく続くサロンに。"]} eyebrow="業種別ガイド / ひとりサロン" intro="予約、会計、集客も、ひとりで抱えすぎないために。お客さまの動きに合わせて、準備を整えます。" active="industries" breadcrumbs={[{label:'開業準備',href:'/akindo/kaigyo/'},{label:'ひとりサロン開業ガイド'}]}>
  <div class="k-container salon-content">
    <div class="salon-lead">
      <div class="salon-lead-copy"><p class="k-eyebrow">あなたらしいサロンの、はじめの一歩</p><h2><span class="k-phrase">施術に集中できる、</span><span class="k-phrase">準備を。</span></h2><p>美容サロン、ネイル、エステ、リラクゼーション、まつげ、個人施術、自宅サロンなど、一人で運営する小さなサロン。</p><p class="salon-lead-note">13の準備を、4つの段階に分けました。<br/>気になる項目の「今日の一歩」から。</p><a class="k-button" href="#salon-foundation">最初の準備を見てみる <span aria-hidden="true">↓</span></a><a class="k-link salon-save-link" href="/akindo/kaigyo/checklist/">進捗を残しながら準備する <span aria-hidden="true">→</span></a></div>
      <figure class="salon-visual"><img src="/akindo/kaigyo-assets/illustrations/salon-scene-v2.webp" srcset="/akindo/kaigyo-assets/illustrations/salon-scene-v2-640.webp 640w, /akindo/kaigyo-assets/illustrations/salon-scene-v2.webp 1200w" sizes="(max-width: 760px) calc(100vw - 40px), 52vw" width="1200" height="800" alt="小さなサロンで、お客さまとネイルの見本を見ながら相談する店主のイラスト" decoding="async" fetchpriority="high"/><figcaption>小さく始めて、ひとつずつ整える。</figcaption></figure>
    </div>
    <div class="salon-flow-wrap"><BusinessFlow id="salon-customer-flow" salon title="お客さまの一日を、思い浮かべてみる。" intro="見つけてもらってから、次の来店まで。この4つがつながれば、使う道具と準備の目的が見えてきます。"/></div>
    <aside class="salon-notice" aria-label="資格・届出・許認可について"><strong>契約や申込みの前に、ご確認ください。</strong><p>必要な届出、資格、許認可は、提供するサービスや地域によって異なります。行政機関、税理士、社会保険労務士などの専門家へご確認ください。</p><p>このガイドは準備の整理を支援するもので、個別の法律・税務・施術の適法性を判断するものではありません。</p></aside>
    <nav class="salon-phase-nav" aria-label="準備の段階から読む"><p class="k-eyebrow">気になる段階から、読んでみる</p><ol>{phases.map((phase, index) => <li><a href={`#${phase.id}`}><span class="phase-nav-number">{String(index + 1).padStart(2,'0')}</span><span><strong>{phase.title}</strong><small>{phase.caption}</small></span><span class="phase-nav-arrow" aria-hidden="true">↓</span></a></li>)}</ol></nav>
    <div class="salon-body">
      <aside class="salon-index"><nav aria-label="サロンガイドの目次"><p class="k-eyebrow">準備の見取り図</p>{phases.map((phase, phaseIndex) => <div class="salon-index-phase"><a class="salon-index-phase-title" href={`#${phase.id}`}><span>{String(phaseIndex + 1).padStart(2,'0')}</span>{phase.title}</a><ol>{salonSections.slice(phase.start,phase.end).map((section, index) => <li><a href={`#${section.id}`}><span aria-hidden="true">{String(phase.start + index + 1).padStart(2,'0')}</span>{section.label}</a></li>)}</ol></div>)}<a class="salon-index-start" href="#start-checklist">チェックリストで始める <span aria-hidden="true">→</span></a><a class="salon-index-start" href="#start-diagnosis">必要な道具を診断する <span aria-hidden="true">→</span></a></nav></aside>
      <div class="salon-article">
        {phases.map((phase, phaseIndex) => <div class="salon-phase" id={phase.id}>
          <div class="salon-phase-heading"><span class="salon-phase-number" aria-hidden="true">{String(phaseIndex + 1).padStart(2,'0')}</span><div><p class="k-eyebrow">STEP {phaseIndex + 1} / 4</p><h2>{phase.title}</h2><p>{phase.description}</p></div></div>
          {salonSections.slice(phase.start,phase.end).map((section, index) => <section class="salon-section" id={section.id} aria-labelledby={`${section.id}-heading`}>
            <div class="salon-section-heading"><div><p class="salon-section-label"><span>{String(phase.start + index + 1).padStart(2, '0')}</span>{section.label}</p><h3 id={`${section.id}-heading`}>{section.titleParts.map(part => <span class="k-phrase">{part}</span>)}</h3></div><ToolGlyph category={section.category ?? sectionGlyphs[section.id] ?? 'checklist'} size={72}/></div>
            <p class="salon-intro">{section.intro}</p>
            <div class="salon-action"><span class="salon-action-mark" aria-hidden="true">↗</span><div><strong>今日の一歩</strong><p>{section.action}</p></div></div>
            <details class="salon-check-details"><summary>確認しておくこと <span class="salon-check-count">{section.checks.length}項目</span><span class="salon-check-toggle" aria-hidden="true">＋</span></summary><ul class="salon-checks">{section.checks.map(check => <li><span aria-hidden="true">✓</span>{check}</li>)}</ul></details>
            <div class="salon-section-links">{section.category && <a class="k-link" href={`/akindo/kaigyo/tools/?category=${section.category}`}>{toolCategories.find(category => category.id === section.category)?.name}の道具を見る <span aria-hidden="true">→</span></a>}{section.source && <a class="salon-source" href={section.source.href}>確認先：{section.source.label} <span aria-hidden="true">↗</span></a>}</div>
          </section>)}
        </div>)}
        <div class="salon-final">
          <section class="k-card" id="start-checklist"><p class="salon-section-label"><span>14</span>準備を進める</p><h2>ひとつ進んだら、<wbr/>チェックしよう。</h2><p>共通チェックリストで、未着手・進行中・完了を記録できます。登録は不要、進捗はこの端末に保存します。</p><a class="k-button" href="/akindo/kaigyo/checklist/">チェックリストを始める <span aria-hidden="true">→</span></a></section>
          <section class="k-card" id="start-diagnosis"><p class="salon-section-label"><span>15</span>必要な道具を整理</p><h2>そろえる順番に、<wbr/>まだ迷ったら。</h2><p>予約や決済の有無など8つの質問から、最初に必要な準備と、開業後でもよい道具を整理します。</p><a class="k-button k-button-secondary" href="/akindo/kaigyo/diagnosis/">開業準備診断へ <span aria-hidden="true">→</span></a></section>
        </div>
      </div>
    </div>
  </div>
</KaigyoLayout>
<style>
  .salon-content{padding-bottom:80px}.salon-lead{display:grid;grid-template-columns:1fr 1.15fr;gap:42px;align-items:center;padding:28px 0 46px}.salon-lead-copy .k-eyebrow{margin-bottom:14px}.salon-lead-copy h2{font-size:clamp(1.6rem,2.8vw,2.15rem);letter-spacing:-.035em;line-height:1.65;margin:0 0 18px}.salon-lead-copy>p:not(.k-eyebrow){font-size:.9rem;line-height:1.95;margin:12px 0 16px;color:var(--color-text-muted)}.salon-lead-copy .salon-lead-note{font-size:.85rem}.salon-lead .k-button{margin-top:8px}.salon-save-link{display:flex;align-items:center;gap:10px;min-height:44px;margin-top:9px;font-size:.8rem}.salon-visual{margin:0;position:relative}.salon-visual img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover;border-radius:45% 45% 18px 18px;background:#f0e9d6}.salon-visual figcaption{display:inline-block;position:relative;left:24px;margin-top:-14px;padding:8px 16px;background:#fffdf5;border:1px solid #e6dfcc;transform:rotate(-2deg);font-size:.8rem;color:#466047;font-weight:650;box-shadow:0 3px 0 #ede7d4}.salon-flow-wrap{margin-block:14px 28px}.salon-notice{margin:0 0 48px;padding:21px 25px;border-left:3px solid var(--color-brand);background:var(--color-soft-yellow,#f9edc9);border-radius:0 14px 14px 0;line-height:1.9;font-size:.81rem}.salon-notice p{margin:8px 0 0}.salon-notice p:last-child{color:var(--color-text-muted);font-size:.77rem}.salon-phase-nav{margin-bottom:48px}.salon-phase-nav>.k-eyebrow{margin-bottom:16px}.salon-phase-nav ol{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.salon-phase-nav a{display:flex;align-items:flex-start;gap:11px;position:relative;min-height:100px;padding:19px 17px 24px;background:#fffdf7;border:1px solid var(--color-border);border-radius:14px;text-decoration:none;color:inherit;transition:border-color .2s,transform .2s}.salon-phase-nav a:hover{border-color:#294c3b;transform:translateY(-2px)}.phase-nav-number{font-size:1.1rem;line-height:1.8;color:var(--color-brand-dark);font-weight:600}.salon-phase-nav strong{font-size:.88rem;line-height:1.8;display:block}.salon-phase-nav small{display:block;font-size:.69rem;line-height:1.9;margin-top:3px;color:var(--color-text-muted)}.phase-nav-arrow{position:absolute;bottom:10px;right:15px;color:var(--color-brand-dark);font-size:16px}.salon-body{display:grid;grid-template-columns:220px minmax(0,1fr);gap:62px;align-items:start}.salon-index{position:sticky;top:106px}.salon-index .k-eyebrow{margin-bottom:17px}.salon-index-phase{margin-bottom:12px}.salon-index-phase-title{display:flex;gap:10px;align-items:center;min-height:36px;font-size:.78rem;font-weight:750;text-decoration:none;color:#294c3b}.salon-index-phase-title span{font-size:.7rem;color:var(--color-brand-dark)}.salon-index ol{list-style:none;margin:2px 0 0;padding:0 0 0 21px;border-left:1px solid var(--color-border)}.salon-index ol a{display:flex;gap:9px;align-items:center;min-height:34px;font-size:.72rem;line-height:1.6;text-decoration:none;color:var(--color-text-muted)}.salon-index a:hover{text-decoration:underline;text-underline-offset:4px;color:var(--color-brand-dark)}.salon-index ol a span{font-size:.65rem;font-weight:700}.salon-index-start{display:flex;align-items:center;justify-content:space-between;gap:5px;border-top:1px solid var(--color-border);min-height:42px;font-size:.73rem;font-weight:650;text-decoration:none}.salon-phase{scroll-margin-top:110px;margin-bottom:44px}.salon-phase-heading{display:flex;gap:22px;align-items:start;padding:25px 28px;background:#e9ede0;border-radius:17px;margin-bottom:35px}.salon-phase-number{font-size:2.9rem;line-height:1.15;letter-spacing:-.05em;color:#8b9e7d;font-weight:500;padding-top:5px}.salon-phase-heading .k-eyebrow{margin-bottom:6px}.salon-phase-heading h2{font-size:1.55rem;letter-spacing:-.025em;line-height:1.6;margin:0}.salon-phase-heading p:last-child{font-size:.83rem;line-height:1.9;margin:8px 0 0;color:var(--color-text-muted)}.salon-section{padding-bottom:32px;margin-bottom:32px;border-bottom:1px solid var(--color-border);scroll-margin-top:110px}.salon-section-heading{display:flex;align-items:center;justify-content:space-between;gap:22px;margin-bottom:18px}.salon-section-heading>div{min-width:0}.salon-section-label{display:flex;gap:10px;align-items:center;font-size:.77rem;font-weight:700;color:var(--color-brand-dark);margin:0 0 11px}.salon-section-label span{font-size:.73rem;min-width:26px;height:26px;display:grid;place-items:center;background:var(--color-soft-yellow,#f9edc9);border-radius:50%}.salon-section h3{font-size:clamp(1.25rem,2.1vw,1.55rem);line-height:1.65;letter-spacing:-.025em;margin:0;text-wrap:pretty}.salon-intro{font-size:.91rem;line-height:1.95;margin:0 0 19px;color:var(--color-text-muted)}.salon-action{padding:18px 21px;background:#f6efd8;border-left:3px solid #c0942b;border-radius:0 12px 12px 0;display:flex;align-items:flex-start;gap:15px}.salon-action-mark{width:27px;height:27px;flex:none;border-radius:50%;background:#e6b749;color:#294c3b;display:grid;place-items:center;font-size:18px;margin-top:3px}.salon-action strong{font-size:.74rem;color:#795821}.salon-action p{margin:6px 0 0;font-size:.87rem;line-height:1.9;font-weight:650}.salon-check-details{margin-top:15px;border-bottom:1px solid var(--color-border)}.salon-check-details summary{min-height:46px;display:flex;align-items:center;gap:10px;font-size:.8rem;font-weight:650;cursor:pointer;list-style:none}.salon-check-details summary::-webkit-details-marker{display:none}.salon-check-count{font-size:.7rem;font-weight:500;color:var(--color-text-muted)}.salon-check-toggle{margin-left:auto;font-size:18px;transition:transform .2s}.salon-check-details[open] .salon-check-toggle{transform:rotate(45deg)}.salon-checks{list-style:none;padding:0;margin:8px 0 19px;display:grid;gap:12px}.salon-checks li{display:flex;gap:12px;font-size:.85rem;line-height:1.9}.salon-checks li span{color:var(--color-brand-dark);font-weight:800}.salon-section-links{display:flex;flex-wrap:wrap;align-items:center;gap:5px 18px;margin-top:9px}.salon-section-links a{font-size:.8rem;line-height:1.8;min-height:44px;display:inline-flex;align-items:center;gap:6px}.salon-section-links .salon-source{font-size:.73rem;color:var(--color-text-muted);text-underline-offset:4px}.salon-final{display:grid;gap:20px}.salon-final section{padding:30px;scroll-margin-top:110px}.salon-final section:first-child{background:var(--color-soft-yellow,#f9edc9)}.salon-final h2{font-size:1.5rem;line-height:1.6;margin:0 0 14px}.salon-final section>p:not(.salon-section-label){font-size:.9rem;line-height:1.9;margin:0 0 22px}
  @media(max-width:1000px){.salon-body{grid-template-columns:190px minmax(0,1fr);gap:30px}.salon-phase-nav ol{grid-template-columns:repeat(2,minmax(0,1fr))}.salon-phase-nav a{min-height:86px}.salon-lead{gap:26px}.salon-lead-copy h2{font-size:1.6rem}.salon-phase-heading{padding:23px}.salon-section-heading{gap:12px}.salon-section-heading :global(.tool-glyph){width:60px}}
  @media(max-width:760px){.salon-lead{grid-template-columns:1fr;gap:30px;padding:8px 0 34px}.salon-visual{order:-1;max-width:560px;margin:0 auto;width:100%}.salon-visual img{max-height:320px;object-fit:cover}.salon-visual figcaption{left:17px;font-size:.75rem}.salon-lead-copy h2{font-size:1.65rem;margin-bottom:14px}.salon-lead-copy .k-button{width:100%}.salon-save-link{justify-content:center}.salon-lead-copy>p:not(.k-eyebrow){font-size:.88rem}.salon-body{grid-template-columns:1fr;gap:0}.salon-index{display:none}.salon-notice{margin-bottom:34px;padding:19px 20px}.salon-phase-nav{margin-bottom:32px}.salon-phase-nav ol{gap:9px}.salon-phase-nav a{padding:15px 13px 24px;gap:8px;min-height:114px}.salon-phase-nav strong{font-size:.8rem}.salon-phase-nav small{font-size:.68rem}.phase-nav-number{font-size:.95rem}.salon-phase{margin-bottom:34px}.salon-phase-heading{gap:16px;padding:22px 20px;margin-bottom:27px}.salon-phase-number{font-size:2.45rem}.salon-phase-heading h2{font-size:1.4rem}.salon-phase-heading p:last-child{font-size:.8rem}.salon-section{padding-bottom:26px;margin-bottom:26px}.salon-section h3{font-size:1.22rem}.salon-section-heading :global(.tool-glyph){width:58px}.salon-intro{font-size:.88rem}.salon-action{padding:16px;gap:11px}.salon-action p{font-size:.84rem}.salon-action-mark{width:24px;height:24px;font-size:16px}.salon-final section{padding:24px}.salon-final .k-button{width:100%;font-size:.84rem}.salon-content{padding-bottom:48px}}
  @media(max-width:359px){.salon-section-heading{gap:8px}.salon-section-heading :global(.tool-glyph){width:45px}.salon-section h3{font-size:1.1rem}.salon-phase-nav a{display:block}.phase-nav-number{display:block}.salon-phase-heading{padding:19px 16px}.salon-phase-number{font-size:2rem}.salon-action-mark{display:none}}
</style>
