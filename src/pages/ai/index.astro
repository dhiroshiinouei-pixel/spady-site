---
import CorporateLayout from '../../layouts/CorporateLayout.astro';
import { aiRoomArticles } from '../../data/ai-room';
const featured = aiRoomArticles.find(article => article.featured)!;
const more = aiRoomArticles.filter(article => !article.featured);
---
<CorporateLayout page="ai/" title="SpadyのAI部屋｜店舗・中小企業のための生成AI活用ガイド" description="小樽のSpadyが、店舗・中小企業向けにChatGPTなどの生成AIを解説。新機能の使い方と、予約集計や問い合わせ対応など日々の仕事で試せる手順を紹介します。">
  <main id="main">
    <header class="room-masthead"><div class="wrap">
      <nav class="breadcrumb" aria-label="パンくずリスト"><a href="/">ホーム</a><span aria-hidden="true">/</span><span aria-current="page">SpadyのAI部屋</span></nav>
      <p class="room-label">SPADY JOURNAL</p>
      <h1>SpadyのAI部屋</h1>
      <p class="lead">AIのニュースを、仕事で使える話に。<br />ChatGPTなどの新機能と、お店や小さな会社で試せる生成AIの使い方を紹介します。予約件数の整理や問い合わせの下書きなど、身近な仕事から始められます。</p>
    </div></header>
    <section class="wrap room-edition" aria-labelledby="feature-title">
      <div class="room-rule"><h2 id="feature-title">注目の記事</h2><span aria-hidden="true">FEATURE</span></div>
      <article>
        <a class="room-feature" href={featured.href}>
          <img src={featured.image} alt="" width="1440" height="810" fetchpriority="high" decoding="async" />
          <div class="room-copy">
            <p class="room-category">{featured.category}</p>
            <h3>{featured.title}</h3>
            <p>{featured.description}</p>
            <span class="room-read" aria-hidden="true">記事を読む</span>
          </div>
        </a>
      </article>
      <div class="room-rule room-rule-more"><h2>実践ガイド</h2><span aria-hidden="true">GUIDE</span></div>
      <ul class="room-grid">
        {more.map(item => (
          <li>
            <article>
              <a class="room-card" href={item.href}>
                <img src={item.image} alt="" width="1440" height="810" loading="lazy" decoding="async" />
                <div class="room-copy">
                  <p class="room-category">{item.category}</p>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                  <span class="room-read" aria-hidden="true">記事を読む</span>
                </div>
              </a>
            </article>
          </li>
        ))}
      </ul>
    </section>
    <section class="section room-services" aria-labelledby="support-title">
      <div class="wrap split">
        <div><p class="kicker">SpadyのAI支援</p><h2 id="support-title">チームで学ぶ。<br />仕事で使い始める。</h2></div>
        <div class="prose">
          <p><a class="text-link" href="/services/ai-training/">AI研修・講演会</a>：生成AIの基本と、安全に使うための注意点を学ぶ。</p>
          <p><a class="text-link" href="/services/ai-implementation/">AI導入・伴走支援</a>：一つの業務を選び、現場で使える手順を整える。</p>
        </div>
      </div>
    </section>
  </main>
</CorporateLayout>
<style>
  .room-masthead { padding:clamp(32px,5vw,64px) 0 clamp(32px,5vw,56px); }
  .room-label { font-size:.82rem; letter-spacing:.17em; color:#574783; font-weight:800; margin:clamp(24px,4vw,46px) 0 8px; }
  .room-masthead h1 { font-size:clamp(2.25rem,6vw,4.65rem); line-height:1.16; letter-spacing:-.045em; margin:0 0 16px; }
  .room-masthead .lead { margin:0; line-height:1.8; }
  .room-edition { padding-bottom:clamp(54px,8vw,110px); }
  .room-rule { display:flex; justify-content:space-between; gap:12px; align-items:baseline; border-top:2px solid var(--ink); padding:13px 0 16px; }
  .room-rule h2 { margin:0; font-size:clamp(1.25rem,2.8vw,1.65rem); }
  .room-rule span { color:#574783; font-size:.78rem; font-weight:800; letter-spacing:.13em; }
  .room-rule-more { margin-top:clamp(42px,7vw,80px); }
  .room-feature,.room-card { display:grid; overflow:hidden; border:1px solid var(--line); border-radius:14px; background:#fff; text-decoration:none; min-width:0; }
  .room-feature { grid-template-columns:minmax(0,1.45fr) minmax(0,1fr); background:#11172d; color:#f7f6ff; border-color:#252b48; }
  .room-feature img,.room-card img { width:100%; height:100%; object-fit:cover; aspect-ratio:16/9; display:block; }
  .room-feature .room-copy { padding:clamp(24px,4vw,50px); }
  .room-copy { min-width:0; padding:clamp(20px,3vw,32px); display:flex; flex-direction:column; align-items:flex-start; }
  .room-copy h3 { margin:9px 0 12px; font-size:clamp(1.24rem,2.6vw,2rem); line-height:1.45; overflow-wrap:anywhere; }
  .room-copy p { font-size:1rem; line-height:1.75; margin:0 0 18px; }
  .room-copy .room-category { font-size:.85rem; font-weight:800; color:#574783; margin:0; }
  .room-feature .room-category { color:#d5c8ff; }
  .room-feature:hover,.room-card:hover { border-color:#7c67b2; }
  .room-feature:focus-visible,.room-card:focus-visible { outline:3px solid #6757a9; outline-offset:4px; }
  .room-read { margin-top:auto; text-decoration:underline; text-underline-offset:5px; font-weight:700; }
  .room-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); align-items:start; gap:20px; list-style:none; margin:0; padding:0; }
  .room-card { grid-template-rows:auto 1fr; }
  .room-card h3 { font-size:clamp(1.2rem,2.25vw,1.55rem); }
  .room-services { background:var(--soft-green); }
  @media(max-width:760px) {
    .room-feature,.room-grid { grid-template-columns:minmax(0,1fr); }
    .room-feature img,.room-card img { height:auto; }
  }
</style>
