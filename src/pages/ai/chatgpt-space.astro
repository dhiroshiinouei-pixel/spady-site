<script>
  const button = document.querySelector<HTMLButtonElement>('#copy-prompt');
  const text = document.getElementById('prompt-text');
  const status = document.getElementById('copy-status');
  if (button && text && status && navigator.clipboard) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(text.textContent?.trim() ?? ''); status.textContent = '指示文をコピーしました。'; }
      catch { status.textContent = '自動コピーできませんでした。指示文を選択してコピーしてください。'; }
    });
  }
</script>
