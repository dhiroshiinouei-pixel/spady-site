---
import CorporateLayout from '../../layouts/CorporateLayout.astro';
import ContactBand from '../../components/corporate/ContactBand.astro';
import ProductArt from '../../components/corporate/ProductArt.astro';
import Icon from '../../components/corporate/Icon.astro';
import { services,statusLabels,inquiryUrl } from '../../data/services';
import type {Service} from '../../data/services';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.id},props:{service}}));}
const {service:s}=Astro.props as {service:Service};
const product=s.category==='product';
const planned=product&&['planning','developing','preparing'].includes(s.status);
const ended=s.status==='ended';
const external=s.externalUrl?.startsWith('https://')?s.externalUrl:undefined;
---
<CorporateLayout page={`services/${s.id}/`} title={`${s.name}${product?`（${statusLabels[s.status]}）`:''}｜Spady`} description={s.summary}>
<main id="main"><header class="page-hero"><div class="wrap"><nav class="breadcrumb" aria-label="パンくず"><a href="/">ホーム</a><span>/</span><a href="/services/">サービス一覧</a><span>/</span><span>{s.name}</span></nav><div class="detail-hero-grid"><div><span class={`status ${s.status}`}>{statusLabels[s.status]}</span><p class="kicker">{product?'Spadyの自社サービス':'支援サービス'}</p><h1 class="service-title">{s.nameParts?s.nameParts.map(part=><span>{part}</span>):s.name}</h1><p class="lead">{s.tagline}</p><p style="font-size:14px;line-height:2">{s.summary}</p></div>{s.image?<img class="service-detail-image" src={s.image} alt={s.imageAlt||`${s.name}のイメージ`} width="800" height="600"/>:product?<ProductArt type={s.icon}/>:<div class="detail-hero-icon"><Icon name={s.icon} size={100}/></div>}</div></div></header>
<section class="section wrap"><div class="split"><div><p class="kicker">{product?'こんな方に届けたい':'こんな方を支援します'}</p><h2>{s.shortName}</h2><ul class="tag-list">{s.audience.map(a=><li>{a}</li>)}</ul></div><div><p class="lead" style="font-size:16px">{s.summary}</p>{planned?<div class="notice"><strong>現在は企画・開発準備段階です。</strong><p>掲載している機能・利用の流れは構想であり、提供を確約するものではありません。正式な仕様・料金・開始時期は未定です。</p></div>:<div class="notice">{ended?'このサービスの提供は終了しています。ご契約に関するお問い合わせはサポート窓口へご連絡ください。':product?'現在提供中のサービスです。対応範囲・料金・利用条件を各サービスの案内でご確認ください。':'ご相談から支援範囲を整理し、個別にお見積もりします。現在提供中の受託支援です。'}</div>}{s.id==='line-mini-app'&&<p class="fine-print">LINE公式アカウントの構築をご希望の方は、現在提供中の<a href="/services/line-official-account/" style="text-decoration:underline;color:var(--blue)">構築支援サービス</a>をご覧ください。</p>}{s.id==='line-official-account'&&<p class="fine-print">こちらは受託構築のご案内です。企画中の<a href="/services/line-mini-app/" style="text-decoration:underline;color:var(--blue)">LINEミニアプリを活用した自社サービス</a>とは異なります。</p>}</div></div></section>
{product&&<section class="section" style="background:white"><div class="wrap split"><div><p class="kicker">解決したい課題</p><h2>忙しい毎日の、<br/>こんな負担を軽くしたい。</h2></div><ul class="rule-list">{s.problems.map(p=><li>{p}</li>)}</ul></div></section>}
<section class="section wrap"><div class="section-head"><div><p class="kicker">{planned?'開発を検討している機能':product?'主な機能':'主な支援内容'}</p><h2>{product?'必要なことを、使いやすく。':'目的から、具体的な形へ。'}</h2></div>{planned&&<p>以下は検討中の内容です。技術検証や外部サービスの仕様により、変更する可能性があります。</p>}</div><div class="feature-list">{s.features.map((f,i)=><article><span class="feature-number">{String(i+1).padStart(2,'0')}</span><h3>{f.title}</h3><p>{f.text}</p></article>)}</div></section>
<section class="section" style="background:var(--soft-green)"><div class="wrap"><div class="section-head"><div><p class="kicker">{planned?'利用開始までの流れ（構想）':product?'利用開始までの流れ':'ご相談から支援開始まで'}</p><h2>{product?'自分で始められる体験へ。':'内容を確かめてから、始める。'}</h2></div>{planned&&<p>まだ利用開始はできません。正式公開に向けて検討している流れです。</p>}</div><div class="flow-list">{s.flow.map(f=><article><h3>{f.title}</h3><p>{f.text}</p></article>)}</div></div></section>
<section class="section wrap"><div class="section-head"><div><p class="kicker">よくある質問</p><h2>ご検討の前に。</h2></div></div><div class="faq">{s.faq.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></section>
<section class="section" style="background:white;padding-top:0"><div class="wrap"><div class="split"><div><p class="kicker">{planned?'提供予定のご案内':ended?'提供終了後のご相談':'費用・ご相談について'}</p><h2>{planned?<>決まったことから、<br/>お知らせします。</>:<>まずは、ご希望を<br/>お聞かせください。</>}</h2></div><div><p class="lead" style="font-size:16px">{s.pricing.note}</p>{planned&&<p style="font-size:14px;margin-top:20px;line-height:2">提供開始時の案内をご希望の場合は、フォームからお知らせください。ご要望の送信は、サービスの利用申し込み・契約ではありません。</p>}<div class="hero-actions"><a href={`${inquiryUrl(s)}${planned?'&intent=release':''}`} class="btn">{planned?'リリース案内を希望する':ended?'サポートへ相談する':'このサービスを相談する'} <span aria-hidden="true">↗</span></a>{planned&&<a class="text-link" href={inquiryUrl(s)}>ご質問・ご要望</a>}{external&&!ended&&<a class="text-link" href={external}>サービスの専用サイトへ</a>}</div><p class="fine-print">契約・請求に関するご相談は<a href="/support/" style="text-decoration:underline">カスタマーサポート</a>へ。{!product&&<><a href="/fullfunnelmarketing/" style="text-decoration:underline">従来の支援内容・実績</a>もご覧いただけます。</>}</p></div></div>{s.notice&&<p class="fine-print" style="border-top:1px solid var(--line);padding-top:25px;margin-top:55px">{s.notice}</p>}</div></section>
<ContactBand/></main></CorporateLayout>
