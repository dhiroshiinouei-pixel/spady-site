---
import CorporateLayout from '../../layouts/CorporateLayout.astro';
import ContactBand from '../../components/corporate/ContactBand.astro';
import ProductArt from '../../components/corporate/ProductArt.astro';
import Icon from '../../components/corporate/Icon.astro';
import { products,currentServices,statusLabels } from '../../data/services';
---
<CorporateLayout page="services/" title="サービス一覧｜店舗向けSaaS・広告・LINE・Web制作｜Spady" description="企画・開発準備中の店舗向け自社SaaSと、現在提供しているMeta広告・LINE公式アカウント構築・Web制作・デジタルマーケティング支援をご案内します。">
<main id="main"><header class="page-hero"><div class="wrap"><nav class="breadcrumb" aria-label="パンくず"><a href="/">ホーム</a><span>/</span><span>サービス一覧</span></nav><p class="kicker">サービス一覧</p><h1>お店の可能性を、<br/>仕組みと支援で広げる。</h1><p class="lead">これから生まれる自社サービスと、いまお手伝いできること。<br/>Spadyは、集客と店舗運営の両面から事業を支えます。</p><nav class="page-nav" aria-label="サービスの分類"><a href="#products">企画中の自社サービス ↓</a><a href="#current">現在提供中の支援 ↓</a><a href="#projects">関連プロジェクト ↓</a></nav></div></header>
<section class="section wrap" id="products"><div class="catalog-intro"><p class="kicker">自社開発プロダクト</p><h2>日々の運用を、使いやすいソフトウェアに。</h2><p>全国の店舗・小規模事業者が、自分で使い続けられるクラウドサービスを目指しています。以下は企画・開発準備中で、まだご利用いただけません。</p></div><div class="product-grid">{products.map(s=><a class="product-entry" href={s.detailUrl}><>{s.image?<img class="product-custom-art" src={s.image} alt={s.imageAlt||s.name} width="800" height="500" loading="lazy"/>:<ProductArt type={s.icon}/>}</><div class="product-meta"><span class="status">{statusLabels[s.status]}</span><span>自社開発サービス</span></div><h3 class="service-title">{s.nameParts?s.nameParts.map(part=><span>{part}</span>):s.name}</h3><p>{s.summary}</p><span class="text-link">構想・開発予定を見る</span></a>)}</div><p class="product-notice">機能・料金・提供開始時期は未定です。お申し込み・決済は受け付けていません。外部サービスの提供元による公式提供・認定・推奨を示すものではありません。</p></section>
<section class="section service-catalog" id="current" style="background:white"><div class="wrap"><div class="catalog-intro"><p class="kicker">現在提供しているサービス</p><h2>集客の設計から、制作・運用まで。</h2><p>事業の状況や運用体制を伺い、必要な支援をご提案します。全国オンライン対応。支援範囲や費用は、個別にお見積もりします。</p></div><div class="service-rows">{currentServices.map(s=><a class="service-row" href={s.detailUrl}><span class="service-icon"><Icon name={s.icon}/></span><div><span class="status available">{statusLabels[s.status]}</span><h3 class="service-title">{s.nameParts?s.nameParts.map(part=><span>{part}</span>):s.name}</h3><p>{s.summary}</p></div><span class="row-arrow" aria-hidden="true">↗</span></a>)}</div></div></section>
<section class="section wrap" id="projects"><div class="section-head"><div><p class="kicker">関連プロジェクト</p><h2>学び、伝え、地域とつながる。</h2></div><a href="/projects/" class="text-link">実績・活動の詳細</a></div><div class="related-projects"><a href="/akindo/"><img src="/akindo/assets/akindo-venue-20260722.jpg" alt="AKINDO Labの勉強会" width="1456" height="1092" loading="lazy"/><h3>AKINDO Lab <span aria-hidden="true">↗</span></h3><p>地域の事業者と、デジタル活用を学び合う場。開催内容は専用ページでご案内しています。</p></a><a href="https://localpages.spady.net/"><img src="/akindo/assets/local-pages.jpg" alt="LOCAL PAGES." width="1280" height="720" loading="lazy"/><h3>LOCAL PAGES. <span aria-hidden="true">↗</span></h3><p>お店や事業の魅力を伝えるWeb制作。制作内容や実績を紹介しています。</p></a><a href="https://otaru.spady.net/"><img src="/home/otaru-calendar-og.jpg" alt="小樽暮らしカレンダーの公式OGP。雪景色の小樽運河" width="1200" height="630" loading="lazy"/><h3>小樽暮らしカレンダー <span aria-hidden="true">↗</span></h3><p>小樽で暮らす毎日に役立つ情報を届ける、地域情報プロジェクトです。</p></a></div></section><ContactBand/></main></CorporateLayout>
