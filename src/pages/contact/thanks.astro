---
import HomeLayout from '../../layouts/HomeLayout.astro';
import '../../styles/contact.css';
---
<HomeLayout title="お問い合わせを受け付けました｜Spady" noindex={true}>
  <main id="main" class="thanks-page section-shell">
    <span class="thanks-mark" aria-hidden="true">✓</span><p class="eyebrow">THANK YOU FOR CONNECTING.</p>
    <h1>お問い合わせを<br /><span class="highlight-ink">受け付けました。</span></h1>
    <p>ご連絡ありがとうございます。<br />内容を確認し、通常2営業日以内にお返事いたします。</p>
    <a class="contact-button" href="/"><span class="button-label">ホームへ戻る</span><span aria-hidden="true">↗</span></a>
  </main>
</HomeLayout>
