---
import HomeLayout from '../../layouts/HomeLayout.astro';
import '../../styles/contact.css';
---
<HomeLayout title="お問い合わせ｜Spady" description="集客・採用、Web制作、勉強会、地域での取り組みについてのご相談はこちら。小樽・銭函を拠点に、オンラインで全国・海外にも対応しています。">
  <main id="main" class="inquiry-page section-shell">
    <nav class="breadcrumbs" aria-label="パンくずリスト"><a href="/">ホーム</a><span aria-hidden="true">/</span><span>お問い合わせ</span></nav>
    <div class="inquiry-layout">
      <div class="inquiry-heading">
        <p class="eyebrow">LET’S MAKE A CONNECTION.</p>
        <h1>次のきっかけを、<br /><span class="highlight-ink">ここから。</span></h1>
        <p>集客、Web制作、学び、地域のこと。<br />まだまとまっていなくても大丈夫です。<br />今、考えていることをお聞かせください。</p>
        <ul class="inquiry-points"><li>初回のご相談は無料です</li><li>通常2営業日以内にお返事します</li><li>オンラインで全国・海外に対応</li></ul>
        <a class="contact-line inquiry-line" href="https://s.lmes.jp/landing-qr/2002523511-OZpWpGdr?uLand=O4rFry"><img class="line-icon" src="/home/line.svg" width="26" height="26" alt="" />LINEで相談する <span aria-hidden="true">↗</span></a>
        <span class="inquiry-asterisk" aria-hidden="true">✳</span>
      </div>
      <div class="inquiry-card">
        <form id="inquiryForm" action="/api/contact" method="POST">
          <input type="hidden" name="form_version" value="inquiry-v2" />
          <div class="honeypot" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
          <p class="form-intro">ご相談内容をお聞かせください。<span><b>必須</b> の項目をご入力ください。</span></p>
          <div class="field"><label for="name">お名前 <b class="required">必須</b></label><input id="name" name="name" autocomplete="name" required maxlength="100" placeholder="例：山田 太郎" /></div>
          <div class="field"><label for="company">会社名・屋号 <span class="optional">任意</span></label><input id="company" name="company" autocomplete="organization" maxlength="100" placeholder="例：〇〇商店" /></div>
          <div class="field"><label for="email">メールアドレス <b class="required">必須</b></label><input id="email" name="email" type="email" autocomplete="email" required maxlength="200" placeholder="example@company.jp" /><p class="field-help">お返事をお送りするアドレスをご入力ください。</p></div>
          <div class="field"><label for="topic">ご相談の種類 <b class="required">必須</b></label><select id="topic" name="topic" required><option value="">選択してください</option><option>集客・採用・広告・SNS・LINEの支援</option><option>LP・Webサイト制作（LOCAL PAGES.）</option><option>勉強会・研修（AKINDO Lab）</option><option>小樽暮らしカレンダー・地域の取り組み</option><option>取材・協業・その他</option></select></div>
          <div class="field"><label for="message">お問い合わせ内容 <b class="required">必須</b></label><textarea id="message" name="message" rows="6" required maxlength="4000" placeholder="現在のお悩みや、相談したいことをお聞かせください。短い文章でも大丈夫です。"></textarea></div>
          <details class="meeting-options"><summary>打ち合わせの希望日時を記入する <span>任意</span></summary><div class="field"><label for="pref1">第1希望</label><input id="pref1" name="pref1" maxlength="200" placeholder="例：〇月〇日 午後、日本時間" /></div><div class="field"><label for="pref2">第2希望</label><input id="pref2" name="pref2" maxlength="200" /></div><div class="field"><label for="pref3">第3希望</label><input id="pref3" name="pref3" maxlength="200" /></div></details>
          <label class="consent-field"><input type="checkbox" name="consent" value="yes" required /><span><a href="/privacy/" target="_blank" rel="noopener">プライバシーポリシー</a>に同意のうえ送信します。<b class="required">必須</b></span></label>
          <p class="form-status" id="formStatus" role="status" aria-live="polite" tabindex="-1" hidden></p>
          <button class="contact-button inquiry-submit" type="submit"><span class="button-label">お問い合わせを送信する</span><span aria-hidden="true">↗</span></button>
          <p class="submit-note">ご相談だけでも、お気軽にどうぞ。</p>
        </form>
      </div>
    </div>
  </main>
  <script>
    const form=document.querySelector<HTMLFormElement>('#inquiryForm');
    const status=document.querySelector<HTMLElement>('#formStatus');
    const button=form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    form?.addEventListener('submit',async event=>{
      event.preventDefault();
      if(!button||!status||button.disabled)return;
      button.disabled=true;form.setAttribute('aria-busy','true');
      const label=button.querySelector('.button-label');if(label)label.textContent='送信しています…';
      status.hidden=true;
      const controller=new AbortController();
      const timeout=setTimeout(()=>controller.abort(),20000);
      try{
        const response=await fetch(form.action,{method:'POST',body:new FormData(form),headers:{Accept:'application/json'},signal:controller.signal});
        const result=await response.json().catch(()=>({ok:false}));
        if(!response.ok||result.ok!==true)throw new Error(result.message||'送信できませんでした。入力内容を残したままにしています。少し時間をおいて再度お試しください。');
        window.location.assign('/contact/thanks/');
      }catch(error){
        status.textContent=error instanceof Error && !(error instanceof TypeError) && error.name!=='AbortError'?error.message:'通信の完了を確認できませんでした。入力内容は残っています。少し時間をおいて再度お試しいただくか、LINEからご連絡ください。';
        status.hidden=false;status.focus();button.disabled=false;form.removeAttribute('aria-busy');
        if(label)label.textContent='お問い合わせを送信する';
      }finally{clearTimeout(timeout);}
    });
  </script>
</HomeLayout>
