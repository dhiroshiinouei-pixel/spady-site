---
import CorporateLayout from '../layouts/CorporateLayout.astro';
import ContactBand from '../components/corporate/ContactBand.astro';
import HomeSections from '../components/corporate/HomeSections.astro';
import CrystalScene from '../components/corporate/CrystalScene.astro';
import '../styles/home-renewal.css';
import '../styles/home-sections.css';
import '../styles/crystal.css';
import '../styles/home-play.css';
---
<CorporateLayout>
  <main id="main">
    <section class="h-hero" aria-labelledby="hero-title">
      <div class="wrap h-hero-stage">
        <div class="h-hero-copy">
          <p class="h-hero-eyebrow"><span aria-hidden="true"></span>集客から、店舗運営まで。</p>
          <h1 id="hero-title"><span>お店の毎日を、</span><span class="h-red">シンプルに。</span></h1>
          <div class="h-hero-description"><p class="h-hero-promise">難しいデジタルを、現場で使える形に。</p><p>広告・LINE・Web制作の経験から、<br/><span>お店の集客と運営を支える</span><span>ソフトウェアへ。</span></p></div>
          <div class="h-hero-actions">
            <a class="h-primary" href="/services/"><span>サービスを知る</span><span class="h-arrow" aria-hidden="true">↗</span></a>
            <a class="h-simple-link" href="/about/">Spadyについて <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="h-hero-visual" data-hero-visual>
          <CrystalScene/>
          <button class="motion-control h-motion" type="button" aria-pressed="false" data-pause="演出を停止" data-play="演出を再開" data-reduced="演出を停止中"><span class="motion-symbol" aria-hidden="true">Ⅱ</span><span class="motion-label">演出を停止</span></button>
        </div>
      </div>
      <div class="wrap h-hero-bottom">
        <p><span class="h-state-dot" aria-hidden="true"></span><span>自社SaaSは企画・開発準備中。<br class="h-mobile-break"/>広告・Web・LINEの支援は提供中です。</span></p>
        <a href="#about" class="h-scroll" aria-label="Spadyが目指すことへスクロール"><span>Spadyが目指すこと</span><span aria-hidden="true">↓</span></a>
      </div>
    </section>
    <HomeSections/>
    <div id="contact"><ContactBand/></div>
  </main>
  <script>import '../scripts/crystal-scene';import '../scripts/home-play';</script>
</CorporateLayout>
