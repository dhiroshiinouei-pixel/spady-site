---
import CorporateLayout from '../layouts/CorporateLayout.astro';
import ContactBand from '../components/corporate/ContactBand.astro';
import ProductArt from '../components/corporate/ProductArt.astro';
import Icon from '../components/corporate/Icon.astro';
import { products, currentServices, statusLabels } from '../data/services';
---
<CorporateLayout>
<main id="main">
 <section class="corp-hero wrap" aria-labelledby="hero-title"><div class="hero-grid"><div class="hero-heading"><p class="kicker">店舗・小規模事業者のためのデジタルサービス</p><h1 id="hero-title"><span>お店の集客と運営を、</span><span>もっと<em>シンプルに。</em></span></h1><p class="hero-copy">広告、Web、LINE。その支援で培った経験を、<br/>毎日の仕事に役立つソフトウェアへ。<br/>Spadyは、現場で使える仕組みをつくります。</p><div class="hero-actions"><a class="btn" href="/services/">サービスを知る <span aria-hidden="true">↗</span></a><a class="text-link" href="/about/">Spadyについて</a></div><p class="hero-status"><span>自社SaaSは企画・開発準備中。</span><span>広告・Web・LINEの支援は提供中です。</span></p></div><ProductArt hero/></div><div class="hero-foot"><span>北海道小樽市銭函から、全国の事業者へ。</span><a href="#about">Spadyが目指すこと <span aria-hidden="true">↓</span></a></div></section>
 <section class="section wrap mission" id="about"><div><p class="kicker">Spadyが目指すこと</p><h2>難しいデジタルを、<br/>現場で使える形に。</h2></div><div class="mission-copy"><p>お客さまに向き合う時間を、もっと。<br/>日々の集客や運営に追われる時間を、少しでも軽く。</p><p>私たちは、店舗や小規模事業者の<strong>「自分たちで続けられる仕組み」</strong>を大切にしています。マーケティングの実務経験を土台に、使いやすいクラウド型ソフトウェアの開発へ取り組んでいきます。</p><a href="/about/" class="text-link">Spadyの考え方</a></div></section>
 <section class="section products-section" id="projects"><div id="products"></div><div class="wrap"><div class="section-head"><div><p class="kicker">これからの自社サービス</p><h2>お店の毎日から、<br/>次のサービスを。</h2></div><p>集客の入口から、来店後のつながりまで。<br/>まずは、2つのサービスを企画しています。</p></div><div class="product-grid">{products.slice(0,2).map(p=><a class="product-entry" href={p.detailUrl}><>{p.image?<img class="product-custom-art" src={p.image} alt={p.imageAlt||p.name} width="800" height="500" loading="lazy"/>:<ProductArt type={p.icon}/>}</><div class="product-meta"><span class="status">{statusLabels[p.status]}</span><span>自社開発サービス</span></div><h3 class="service-title">{p.nameParts?p.nameParts.map(part=><span>{part}</span>):p.name}</h3><p>{p.summary}</p><span class="text-link">構想・開発予定を見る</span></a>)}</div><a class="text-link" href="/services/#products" style="margin-top:25px">自社サービスの一覧を見る</a><p class="product-notice">いずれも企画・開発準備段階です。提供機能・料金・開始時期は未定で、利用申し込みや決済は受け付けていません。GoogleおよびLINEヤフー株式会社による公式提供・認定・推奨を示すものではありません。</p></div></section>
 <section class="section wrap support-section" id="services"><div><p class="kicker">現在提供している支援</p><h2>いま必要なことも、<br/>一緒に整えます。</h2><p class="lead" style="font-size:15px;margin-top:24px">集客の設計から、制作、運用まで。<br/>事業に合った取り組みを、全国へオンラインで。</p><a href="/services/#current" class="text-link" style="margin-top:22px">支援サービスの一覧</a></div><div class="service-rows">{currentServices.map(s=><a class="service-row" href={s.detailUrl}><span class="service-icon"><Icon name={s.icon}/></span><div><h3>{s.name}</h3><p>{s.summary}</p></div><span class="row-arrow" aria-hidden="true">↗</span></a>)}</div></section>
 <section class="section strength-band"><div class="wrap"><div class="section-head"><div><p class="kicker">Spadyの強み</p><h2>現場を知ることから、<br/>使える仕組みは生まれる。</h2></div></div><div class="strength-grid"><article><span class="strength-number">01</span><h3>集客の流れを、<br/>つなげて考える。</h3><p>広告だけ、Webだけで終わらせず、見つけてもらうところから問い合わせ・来店まで、事業全体の流れを整理します。</p></article><article><span class="strength-number">02</span><h3>つくる視点と、<br/>運用する視点。</h3><p>LINE公式アカウントやWeb制作の経験を土台に、見た目だけでなく、日々の使いやすさと続けやすさを考えます。</p></article><article><span class="strength-number">03</span><h3>小さく始めて、<br/>育てていく。</h3><p>いまの課題と、これからの事業に目を向けて。必要なことの優先順位を整理し、無理のない仕組みづくりを目指します。</p></article></div></div></section>
 <section class="section wrap" id="stories"><div class="section-head"><div><p class="kicker">実績・活動</p><h2>人と事業に向き合う、<br/>私たちの仕事。</h2></div><a class="text-link" href="/projects/">実績・プロジェクトを見る</a></div><div class="story-grid"><a class="story-card" href="/fullfunnelmarketing/"><div class="story-image qq"><img src="/logo-qqenglish.png" alt="QQEnglish" width="244" height="87" loading="lazy"/></div><p class="story-category">LINE公式アカウント構築支援</p><h3>留学とオンライン英会話。<br/>2つの事業を支えるLINE構築。</h3><p>QQEnglish様の支援について</p></a><a class="story-card" href="https://localpages.spady.net/#works"><div class="story-image"><img src="/akindo/assets/local-pages.jpg" alt="LOCAL PAGES.のブランドビジュアル" width="1280" height="720" loading="lazy"/></div><p class="story-category">Webサイト制作</p><h3>お店の空気も、事業の想いも。<br/>伝わるページをつくる。</h3><p>LOCAL PAGES.の制作実績</p></a><a class="story-card" href="/akindo/#scene"><div class="story-image"><img src="/akindo/assets/akindo-venue-20260722.jpg" alt="AKINDO Labの勉強会で学ぶ参加者の様子" width="1456" height="1092" loading="lazy"/></div><p class="story-category">地域事業者との学び</p><h3>学んで、試して、次につなぐ。<br/>小樽から広がるデジタル活用。</h3><p>AKINDO Labの活動</p></a></div></section>
 <section class="section founder-section" id="profile"><div class="wrap founder-grid"><div class="founder-portrait"><img src="/profile.jpg" alt="Spady代表の井上博史" width="320" height="320" loading="lazy"/><small>北海道・小樽市銭函を拠点に活動</small></div><div class="founder-copy"><p class="kicker">代表者紹介</p><h2>事業のそばで考え、<br/>自分の手で、つくる。</h2><p>マーケティングの現場で重ねてきた経験を、もっと身近な道具に。広告・LINE・Web制作の支援を続けながら、店舗や小規模事業者が自分で使えるソフトウェアづくりへ取り組んでいます。</p><div class="founder-name"><strong>井上 博史</strong><small>Spady 代表 ／ 個人事業</small></div><a class="text-link" href="/about/#profile">代表者・事業者情報を見る</a></div></div></section>
 <section class="section wrap news-layout"><div><p class="kicker">お知らせ・サービス開発情報</p><h2>これからのこと。<br/>日々の取り組み。</h2><a class="text-link" href="/news/" style="margin-top:15px">お知らせ一覧</a></div><div class="news-list"><a class="news-item" href="/news/saas-development/"><small>開発方針</small><strong>店舗向けSaaSの企画について。最初の2つのサービスと、Spadyが目指すこと。</strong><span aria-hidden="true">↗</span></a><a class="news-item" href="/akindo/"><small>学び・活動</small><strong>地域の事業者と学ぶ、AKINDO Lab。開催情報と活動はこちら。</strong><span aria-hidden="true">↗</span></a><a class="news-item" href="https://otaru.spady.net/"><small>地域の情報</small><strong>小樽で暮らす日々のために。小樽暮らしカレンダー。</strong><span aria-hidden="true">↗</span></a></div></section>
 <div id="contact"><ContactBand/></div>
</main>
</CorporateLayout>
