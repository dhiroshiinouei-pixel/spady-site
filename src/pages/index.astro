---
import HomeLayout from '../layouts/HomeLayout.astro';
const projects = [
  {number:'01',category:'MARKETING',title:'マーケティング支援',copy:'商いの「届く」を、つくる。',description:'広告・SNS・LINEをつなぎ、集客と採用の流れを整える。地域のお店から、全国・海外の事業まで。',href:'/fullfunnelmarketing/',link:'支援内容を見る',theme:'blue',image:'/home/megaphone.svg',imageAlt:'マーケティング支援',tags:'Meta広告 / LINE / SNS'},
  {number:'02',category:'WEB DESIGN',title:'LOCAL PAGES.',copy:'地域の魅力を、ひとつのページに。',description:'お店や企業の、まだ伝わっていない魅力を整理。見る人の次の行動につながるLP・Webサイトをつくります。',href:'https://localpages.spady.net/',link:'制作実績・サービスを見る',theme:'yellow',image:'/akindo/assets/local-pages.jpg',imageAlt:'LOCAL PAGES. 地域の魅力を、ひとつのLPに。',tags:'LP制作 / Web制作'},
  {number:'03',category:'LEARNING',title:'AKINDO Lab',copy:'学びから、商いの次の一歩へ。',description:'Instagram、LINE、広告、AI。地域の事業者が、日々の仕事に活かせるデジタル活用を学ぶ勉強会です。',href:'/akindo/',link:'勉強会について知る',theme:'pink',image:'/akindo/assets/akindo-venue-20260722.jpg',imageAlt:'AKINDO Labの勉強会',tags:'勉強会 / デジタル活用'},
  {number:'04',category:'LOCAL LIFE',title:'小樽暮らしカレンダー',copy:'この街の「今日」を、見つけよう。',description:'イベント、子育て、求人など。あちこちにある小樽の情報を、日付から探せる地域のカレンダーです。',href:'https://otaru.spady.net/',link:'暮らしの情報を探す',theme:'green',image:'/home/calendar.svg',imageAlt:'小樽暮らしカレンダー',tags:'地域情報 / 暮らし'}
];
---
<HomeLayout>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-text"><p class="eyebrow"><span class="signal" aria-hidden="true"></span> LOCAL ROOTS. NEW POSSIBILITIES.</p><h1 id="hero-title">地域の魅力に、<br /><span class="highlight-ink">次のきっかけ</span>を。</h1><p class="hero-description">小樽・銭函を拠点に、<br />マーケティングとテクノロジーで、<br />商いと暮らしの「つながる」をつくる。</p><a class="text-link" href="#projects">Spadyの取り組み <span class="arrow-circle" aria-hidden="true">↓</span></a></div>
        <div class="hero-visual"><div class="rotating-seal" aria-hidden="true"><svg viewBox="0 0 120 120"><defs><path id="seal-path" d="M60,60m-44,0a44,44 0 1,1 88,0a44,44 0 1,1 -88,0" /></defs><text><textPath href="#seal-path">SPADY · LOCAL &amp; DIGITAL · SPADY · LOCAL &amp; DIGITAL · </textPath></text></svg><span>✳</span></div><img src="/home/coastal-neighborhood.png" width="1536" height="1024" alt="海辺の街で、人とお店、暮らしがつながる風景のイラスト" fetchpriority="high" /><div class="hero-image-label"><span class="label-dot" aria-hidden="true"></span> 人と、商いと、この街と。</div></div>
        <div class="hero-bottom"><span>BASED IN OTARU / ZENIBAKO, HOKKAIDO</span><a href="#about">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a></div>
      </section>
      <div class="play-ribbon" aria-hidden="true"><div><span>LOCAL <i>✳</i> DIGITAL <i>✳</i> LEARNING <i>✳</i> LIFE <i>✳</i> </span><span>LOCAL <i>✳</i> DIGITAL <i>✳</i> LEARNING <i>✳</i> LIFE <i>✳</i> </span><span>LOCAL <i>✳</i> DIGITAL <i>✳</i> LEARNING <i>✳</i> LIFE <i>✳</i> </span><span>LOCAL <i>✳</i> DIGITAL <i>✳</i> LEARNING <i>✳</i> LIFE <i>✳</i> </span></div></div><section class="about section-shell" id="about" aria-labelledby="about-title"><div class="section-heading"><p class="eyebrow">ABOUT SPADY</p><h2 id="about-title">いいものが、<br />ちゃんと届く地域へ。</h2></div><div class="about-copy"><p>街のお店にも、企業にも、暮らしの中にも。<br class="desktop-break" />まだ十分に伝わっていない魅力があります。</p><p>Spadyは、その魅力を見つけ、伝え、つながるきっかけをつくります。集客の支援も、Web制作も、勉強会も、地域の情報発信も。その根っこにある想いは、同じです。</p><a class="text-link small-link" href="#profile">代表・事業概要 <span class="arrow-circle" aria-hidden="true">↗</span></a></div></section>
      <section class="projects section-shell" id="projects" aria-labelledby="projects-title"><div class="section-top"><div><p class="eyebrow">OUR PROJECTS</p><h2 id="projects-title">ひとつの想いから、<br />広がる取り組み。</h2></div><p class="section-note">商いを支え、学びをひらき、暮らしをつなぐ。<br />Spadyが取り組む、4つのこと。</p></div><div class="project-grid">{projects.map(project=>(<a class={`project-card ${project.theme}`} href={project.href}><div class="project-top"><span>{project.number} / {project.category}</span><span class="project-tags">{project.tags}</span></div><div class={`project-art art-${project.theme}`}><img src={project.image} alt={project.imageAlt} loading="lazy" width="600" height="300" />{(project.theme==='blue'||project.theme==='green') && <span class="art-word" aria-hidden="true">{project.theme==='blue'?'CONNECT.':'TODAY?'}</span>}<span class="art-spark" aria-hidden="true">✳</span></div><p class="project-copy">{project.copy}</p><h3>{project.title}</h3><p class="project-description">{project.description}</p><div class="project-bottom"><span>{project.link}</span><span class="arrow-circle" aria-hidden="true">↗</span></div></a>))}</div></section>
      <section class="stories-band" id="stories" aria-labelledby="stories-title">
        <div class="section-shell">
          <div class="section-top"><div><p class="eyebrow">WORKS & STORIES</p><h2 id="stories-title">つながりから、<br />生まれていること。</h2></div><p class="section-note">小樽の現場から、海外の事業まで。<br />支援の実績と、日々の活動をご紹介します。</p></div>
          <div class="story-grid">
            <a class="story-card" href="/akindo/#scene"><div class="story-image"><img src="/akindo/assets/akindo-venue-20260722.jpg" width="1456" height="1092" loading="lazy" alt="AKINDO Labで参加者にデジタル集客を伝える井上博史" /></div><div class="story-meta"><span>LEARNING</span><span>小樽・銭函</span></div><h3>顔を合わせて、一緒に学ぶ。<br />地域の商いのための勉強会。</h3><p>AKINDO Labの会場から</p><span class="story-arrow" aria-hidden="true">↗</span></a>
            <a class="story-card" href="https://localpages.spady.net/#works"><div class="story-image local-pages-image"><img src="/akindo/assets/local-pages.jpg" width="1280" height="720" loading="lazy" alt="LOCAL PAGES. 地域の魅力を、ひとつのLPに。" /></div><div class="story-meta"><span>WEB DESIGN</span><span>制作実績</span></div><h3>お店の空気も、事業の想いも。<br />伝わるページをつくる。</h3><p>LOCAL PAGES.の制作実績</p><span class="story-arrow" aria-hidden="true">↗</span></a>
            <a class="story-card" href="/fullfunnelmarketing/"><div class="story-image client-image"><img src="/logo-qqenglish.png" width="400" height="140" loading="lazy" alt="QQEnglish" /><span>LINE OFFICIAL ACCOUNT</span></div><div class="story-meta"><span>MARKETING</span><span>フィリピン・セブ島</span></div><h3>留学から、オンライン英会話へ。<br />2つの事業を支えるLINE構築。</h3><p>QQEnglish様のLINE構築 ／ 集客支援について</p><span class="story-arrow" aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
      <section class="topics section-shell" aria-labelledby="topics-title">
        <div><p class="eyebrow">INFORMATION</p><h2 id="topics-title">いま、ご案内していること。</h2><p class="topics-note">サービスや地域の取り組みから。</p></div>
        <div class="topic-list">
          <a href="/akindo/"><span class="topic-tag">勉強会</span><span>AKINDO Labの次回開催情報を、LINEでお届けしています。</span><span class="topic-arrow" aria-hidden="true">↗</span></a>
          <a href="https://localpages.spady.net/#works"><span class="topic-tag">制作実績</span><span>LOCAL PAGES.で、店舗・企業・地域の制作事例をご覧いただけます。</span><span class="topic-arrow" aria-hidden="true">↗</span></a>
          <a href="https://otaru.spady.net/"><span class="topic-tag">地域情報</span><span>小樽のイベントや暮らしの予定を、カレンダーから。</span><span class="topic-arrow" aria-hidden="true">↗</span></a>
        </div>
      </section>
      <section class="profile section-shell" id="profile" aria-labelledby="profile-title">
        <div class="profile-photo"><span class="profile-photo-note">HELLO FROM OTARU.</span><img src="/profile.jpg" width="320" height="320" loading="lazy" alt="Spady代表 井上博史" /><p>地域と、ともに。<span>HIROSHI INOUE / SPADY</span></p></div>
        <div class="profile-copy"><p class="eyebrow">PEOPLE BEHIND SPADY</p><h2 id="profile-title">この街で暮らし、<br />この街から、つなぐ。</h2><p>デジタルを、地域の現場で使える形に。<br />小樽・銭函で暮らしながら、お店や企業の「次の一歩」に伴走しています。</p><div class="profile-name"><h3>井上 博史</h3><span>HIROSHI INOUE / Spady 代表</span></div><p class="profile-bio">前職ではMeta社に出向し、マーケティングプロとして国内80社以上の広告代理店を支援。独立後は100以上のLINE公式アカウントを構築。現在は集客支援やWeb制作に加え、地域事業者向けの勉強会や情報発信にも取り組んでいます。</p><dl class="profile-facts"><div><dt>屋号</dt><dd>Spady</dd></div><div><dt>拠点</dt><dd>北海道小樽市銭函</dd></div><div><dt>対応エリア</dt><dd>北海道 / 全国・海外（オンライン）</dd></div></dl><a class="text-link small-link" href="https://www.threads.com/@hiroshiinoue.spady">日々の活動をThreadsで <span class="arrow-circle" aria-hidden="true">↗</span></a></div>
      </section>
      <section class="contact" id="contact" aria-labelledby="contact-title"><div class="section-shell contact-inner"><div><p class="eyebrow">LET’S TALK</p><h2 id="contact-title">次のきっかけを、<br />一緒につくりませんか。</h2><p>事業のこと、集客のこと、地域のこと。<br />まだ言葉になっていない段階から、お話を聞かせてください。</p></div><div class="contact-links"><a class="contact-button" href="/contact/"><span class="button-label">お問い合わせ</span> <span aria-hidden="true">↗</span></a><a class="contact-line" href="https://s.lmes.jp/landing-qr/2002523511-OZpWpGdr?uLand=O4rFry"><img class="line-icon" src="/home/line.svg" width="26" height="26" alt="" />LINEで相談する <span aria-hidden="true">↗</span></a><span class="contact-note">初回相談無料・オンラインで全国対応</span></div></div></section>
    </main>
</HomeLayout>
