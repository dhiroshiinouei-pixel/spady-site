---
import {metaAdsSetup as service,supports,extras,steps,preparation,faqs} from '../data/meta-ads-setup';
import SiteConsent from '../components/SiteConsent.astro';
import Cta from '../components/meta-ads/Cta.astro';
import ReadableText from '../components/meta-ads/ReadableText.astro';
import Icon from '../components/meta-ads/Icon.astro';
import LineReservation from '../components/meta-ads/LineReservation.astro';
import '../styles/meta-ads-setup.css';
---
<!doctype html>
<html lang="ja"><head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{service.title}</title><meta name="description" content={service.description}/>
  {service.noindex&&<meta name="robots" content="noindex, follow"/>}
  {service.canonical&&<><link rel="canonical" href={service.canonical}/><meta property="og:url" content={service.canonical}/></>}
  <meta property="og:type" content="website"/><meta property="og:site_name" content="Spady"/><meta property="og:locale" content="ja_JP"/>
  <meta property="og:title" content={service.title}/><meta property="og:description" content={service.description}/>
  <meta property="og:image" content={service.canonical ? new URL('/meta-ads-setup/og.png',service.canonical).href : '/meta-ads-setup/og.png'}/>
  <meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Meta広告の初期設定は、専門家に。その後の基本操作は、自社で。Spady"/>
  <meta name="twitter:card" content="summary_large_image"/><meta name="theme-color" content="#f8f7f3"/><link rel="icon" href="/favicon.png"/>
</head><body class="meta-setup-page">
  <a class="skip-link" href="#main">本文へ移動</a>
  <header class="lp-header"><a href="/" class="lp-brand" aria-label="Spady ホーム"><span class="lp-wordmark">Spady</span><span class="lp-service-name"><span class="brand-line">Meta広告</span><span class="brand-line">初期設定サポート</span></span></a>
    <nav aria-label="ページ内ナビゲーション"><a href="#service">サービス内容</a><a href="#pricing">料金</a><a href="#flow">ご利用の流れ</a><a href="#faq">よくある質問</a></nav><Cta placement="header" compact/>
  </header>
  <main id="main">
    <section class="hero hero-reference" aria-labelledby="hero-title"><div class="wrap hero-composition">
      <p class="hero-audience"><span>学習塾・スクール・ジム向け</span></p>
      <div class="hero-heading">
        <h1 id="hero-title"><span>はじめの設定、</span><em>プロにお任せ。</em></h1>
        <p class="hero-promise"><span class="phrase">Meta広告の初期設定から、</span><span class="phrase">自社での基本操作まで。</span></p>
      </div>
      <aside class="hero-experience" aria-label="Spady代表の広告支援経験">
        <p class="experience-career"><span>{service.credentials[0].prefix}</span><strong>{service.credentials[0].emphasis}</strong></p>
        <p class="experience-agencies"><span>{service.credentials[1].prefix}</span><strong>{service.credentials[1].emphasis}</strong><span>サポート経験</span></p>
      </aside>
      <ul class="hero-service-list" aria-label="料金に含まれる主なサポート">
        <li><Icon name="settings"/><strong><span class="phrase">初期設定＋</span><span class="phrase">広告1件の入稿</span></strong></li>
        <li><Icon name="screen"/><strong><span class="phrase">管理画面の操作説明</span><span class="hero-minutes">{service.lectureMinutes}<span>分</span></span></strong></li>
        <li><Icon name="guide"/><strong><span class="phrase">振り返りに使える</span><span class="phrase">共通の操作ガイド</span></strong></li>
      </ul>
      <figure class="hero-laptop" aria-label="広告管理画面を使った操作説明のイメージ">
        <div class="laptop-screen" role="img" aria-label="操作画面のイメージ。最初の広告の予算・配信地域・リンク先を確認し、予算変更や停止・再開の操作を説明します。実際のMeta管理画面ではありません。">
          <div class="laptop-bar"><span class="mock-app-symbol" aria-hidden="true"><Icon name="ad"/></span><strong>広告の管理</strong><span class="laptop-draft">下書き</span></div>
          <div class="laptop-body"><div class="laptop-sidebar" aria-hidden="true"><Icon name="settings"/><Icon name="ad"/><Icon name="sliders"/></div><div class="laptop-content">
            <div class="laptop-tabs"><span>キャンペーン</span><span>広告セット</span><span>広告</span></div>
            <p class="laptop-title">配信前の設定を確認<span aria-hidden="true">✓</span></p>
            <div class="laptop-row"><span>予算</span><b>設定内容を確認</b><i aria-hidden="true"></i></div>
            <div class="laptop-row"><span>配信地域</span><b>設定内容を確認</b><i aria-hidden="true"></i></div>
            <div class="laptop-row"><span>リンク先</span><b>設定内容を確認</b><i aria-hidden="true"></i></div>
            <div class="laptop-controls"><span>予算を変更</span><span>停止・再開</span></div>
          </div></div>
        </div>
        <div class="laptop-base" aria-hidden="true"></div>
        <figcaption>操作画面のイメージです。<wbr/>実際のMeta管理画面とは異なります。</figcaption>
      </figure>
      <div class="hero-offer">
        <div class="hero-price"><div><span class="price-number">{service.price}</span><span class="yen">円<span>（{service.tax}）</span></span></div><p>買い切り・<br/><strong>月額契約不要</strong></p></div>
        <div class="hero-actions"><Cta placement="hero"/><p class="cta-note">{service.ctaNoteParts.map(part=><span class="phrase">{part}</span>)}</p></div>
      </div>
      <div class="hero-details"><p class="hero-footnote"><span>広告費は別途必要です。</span><span>広告素材はお客様にご用意いただきます。</span><span>Pixelのサイト設置・イベント計測は別料金です。</span></p><p class="credentials-note"><ReadableText text={service.credentialsNote}/></p><a href="#service" class="secondary-cta">{service.secondaryCta}<span aria-hidden="true">↓</span></a></div>
    </div></section>

    <section class="section concerns"><div class="wrap concerns-grid"><div><p class="section-label">01 <span>こんなお悩みに</span></p><h2><span>「広告を始めたい」が、</span><span>設定で止まって<wbr/>いませんか？</span></h2><p class="section-intro">最初の設定を整え、<wbr/>基本操作を一緒に確認する。<br/>Spadyは、広告を自社で始めるための準備を支援します。</p><div class="audience-examples"><small>対象となる事業の例</small><span>学習塾</span><span>各種スクール</span><span>ジム・フィットネス</span></div><p class="small-note">その他の業種もご相談いただけます。対応可否は個別に確認します。</p></div><ul class="concern-list">{['アカウントの作成や連携が複雑で、先に進めない','毎月の運用代行ではなく、最初だけ専門家に任せたい','設定後に、予算変更や停止の操作で迷いたくない','何ができて、何が別料金なのかを先に知りたい'].map(text=><li><span aria-hidden="true"><Icon name="check"/></span>{text}</li>)}</ul></div></section>

    <section id="service" class="section support-section"><div class="wrap"><header class="section-heading"><p class="section-label">02 <span>サービス内容</span></p><h2><span>{service.price}円に含まれる、</span><span>6つのサポート。</span></h2><p>初期環境の設定から、最初の広告入稿、操作説明まで。<br class="desktop-break"/>ご相談時に状況を確認し、対応範囲をご案内します。</p></header>
      <div class="support-grid">{supports.map(item=><article class:list={['support-item',{'pixel-item':item.caution}]}><div class="support-top"><span>{item.number}</span><Icon name={item.icon}/></div><h3>{item.title}</h3><p class="support-summary">{item.summary}</p><p>{item.text}</p><p class="support-note"><ReadableText text={item.note}/></p></article>)}</div>
      <div class="ownership-note"><Icon name="shield"/><p>アカウント・広告資産はお客様が所有し、必要な権限だけを共有いただきます。<br class="desktop-break"/>決済情報の入力は、お客様ご自身でMetaの画面から行っていただきます。</p></div>
    </div></section>

    <section class="section lesson-section"><div class="wrap lesson-grid"><div><p class="section-label">03 <span>操作説明とガイド</span></p><h2><span>設定内容を確認して</span><span>終わりではなく、</span><span>基本操作を一緒に。</span></h2><p class="section-intro">実際の管理画面を見ながら、広告の状況の確認、予算変更、停止・再開などをご説明します。後から確認できる共通の操作ガイドもお渡しします。</p><div class="lesson-duration"><strong>{service.lectureMinutes}<span>分</span></strong><p>オンライン・画面共有<br/>基本操作の確認と質疑応答</p></div><p class="small-note">納品後の継続サポートは含まれません。</p></div><div class="lesson-actions">{[['eye','見る','配信状況、広告費・クリック等を確認。'],['sliders','変更する','予算を変更する手順を確認。'],['pause','止める・再開する','配信の停止と再開の操作を確認。']].map(([icon,title,text],i)=><div><span class="lesson-step">0{i+1}</span><Icon name={icon}/><div><h3>{title}</h3><p>{text}</p></div></div>)}<p class="guide-note"><Icon name="guide"/><span>説明の後も、共通ガイドで振り返れます。</span></p></div></div></section>

    <section id="pricing" class="section pricing-section"><div class="wrap"><header class="section-heading"><p class="section-label">04 <span>料金・対応範囲</span></p><h2><span>料金と対応範囲を、</span><span>先に明確に。</span></h2></header><div class="pricing-layout"><div class="price-panel"><span class="plan-label">A. 料金に含まれる内容</span><p class="contract-label">{service.contract}</p><p class="plan-price"><strong>{service.price}</strong><span>円（税込）</span></p><p class="plan-unit">1事業・1広告アカウント ／ オンライン</p><ul>{supports.map(item=><li><Icon name="check"/><span>{item.title}</span></li>)}</ul><Cta placement="pricing"/><p class="cta-note">{service.ctaNoteParts.map(part=><span class="phrase">{part}</span>)}</p><p class="plan-disclaimer"><ReadableText text="初期設定・説明・所定の納品物の提供をもって完了します。納品後の継続サポートは含みません。"/></p></div><div class="scope-panel"><div class="scope-group"><div class="scope-title"><span>B</span><h3>別料金でご相談いただけること</h3></div><p class="estimate-label">別途お見積もり</p><ul>{extras.map(item=><li><ReadableText text={item}/></li>)}</ul></div><div class="scope-group unavailable"><div class="scope-title"><span>C</span><h3>対応していないこと</h3></div><p><ReadableText text="広告アカウント等の停止・制限の解除、復旧作業、異議申し立て代行"/></p></div><div class="price-notes"><p><strong>広告費はMetaへ直接お支払いいただきます。</strong></p><p><ReadableText text="追加サービスの契約は必須ではありません。標準範囲外のご依頼は、事前にお見積もりします。"/></p></div></div></div></div></section>

    <section class="section about-section"><div class="wrap about-grid"><div class="profile-visual"><img src="/profile.jpg" width="320" height="320" alt="Spady代表 井上博史" loading="lazy"/><p>Spady 代表<strong>井上 博史</strong><span>HIROSHI INOUE</span></p></div><div><p class="section-label">05 <span>Spadyについて</span></p><h2><span>広告・LINE・Webの</span><span>実務経験を、最初の設定に。</span></h2><p class="profile-lead">前職ではMeta社に出向し、マーケティングプロとして国内80社以上の広告代理店を支援。</p><p class="profile-credential"><Icon name="check"/><span><ReadableText text={service.profileCredential}/></span></p><ul class="profile-expertise" aria-label="ご相談いただける領域">{service.profileExpertise.map(expertise=><li>{expertise}</li>)}</ul><p>{service.profileDescription}</p><p class="small-note profile-scope-note"><ReadableText text={service.profileScopeNote}/></p><p class="small-note profile-note">Meta Marketing Proは過去の職務経験です。<br/><ReadableText text="本サービスはMeta社の公式サービスではありません。"/></p><a href="/about/" class="text-link">Spady・代表者について <span aria-hidden="true">↗</span></a></div></div></section>

    <section id="flow" class="section flow-section"><div class="wrap flow-grid"><header><p class="section-label">06 <span>ご利用の流れ</span></p><h2><span>まずは状況を確認。</span><span>その後に、正式なお申込み。</span></h2><p class="section-intro">事前確認を行ってから、<wbr/>正式なお手続きをご案内します。</p><p class="small-note">LINEでのご相談・ご予約は、契約やお支払いのお手続きではありません。</p></header><ol class="flow-list">{steps.map(([title,text],i)=><li><span class="flow-number">0{i+1}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></div></section>

    <section class="section preparation-section"><div class="wrap"><header class="section-heading align-left"><p class="section-label">07 <span>ご相談前に</span></p><h2><span>ご準備いただくものと、</span><span>アカウントの確認について。</span></h2></header><div class="preparation-grid"><div><h3>お客様にご用意いただくもの</h3><ul class="preparation-list">{preparation.map(item=><li><Icon name="check"/><span>{item}</span></li>)}</ul><div class="security-note"><Icon name="shield"/><p>Facebookのパスワードやクレジットカード情報を、Spadyにお渡しいただく必要はありません。</p></div></div><div class="restriction-note"><h3>過去・現在の制限状況を確認します</h3><p>過去のポリシー違反・ペナルティや、現在のアカウント制限などにより、初期設定や広告の配信準備を完了できない場合があります。過去の制限歴と現在の状態を確認したうえで、対応可否をご案内します。</p><p class="restriction-emphasis">広告アカウント等の停止・制限の解除、復旧作業、異議申し立て代行には対応していません。</p><p>事前確認後であっても、Meta側の審査・制限によって作業や配信が進まない場合があります。広告審査の承認、配信開始、集客成果は保証していません。</p></div></div>
      <aside class="additional-consultation"><div><p class="eyebrow">必要な場合だけ、追加のご相談も</p><h3>広告の受け皿や、<wbr/>その後のフォローも。</h3></div><p>必要に応じて、LP制作やLINE公式アカウント・エルメの構築についても、別料金でご相談いただけます。<strong>初期設定サービスだけのご利用も可能です。</strong></p></aside>
    </div></section>

    <section id="faq" class="section faq-section"><div class="wrap faq-grid"><header><p class="section-label">08 <span>よくある質問</span></p><h2>気になることを、<wbr/>事前に。</h2></header><div class="faq-list">{faqs.map(([q,a])=><details><summary><span class="question-mark" aria-hidden="true">Q.</span><span>{q}</span><span class="faq-toggle" aria-hidden="true"></span></summary><div class="faq-answer"><p>{a}</p></div></details>)}</div></div></section>

    <section id="consultation" class="section consultation-section"><div class="wrap consultation-grid"><header><p class="section-label">09 <span>ご相談はこちら</span></p><h2><span>最初の設定で、</span><span>立ち止まらないために。</span></h2><p class="section-intro">初期設定・最初の広告入稿・{service.lectureMinutes}分の操作説明まで。まずはLINEで、現在の状況とご希望の日程をお知らせください。</p><div class="final-price"><strong>{service.price}<span>円（税込）</span></strong><p>{service.contract}</p></div><p class="consultation-message"><Icon name="check"/><span>LINEでアカウントの状況と対応範囲を確認します。</span></p><p class="consultation-message"><Icon name="check"/><span>{service.ctaNoteParts.map(part=><span class="phrase">{part}</span>)}</span></p><span class="online-note">{service.delivery}</span></header><LineReservation/></div></section>
  </main>
  <footer class="lp-footer"><div class="wrap"><div class="footer-top"><a href="/" class="footer-brand"><img src="/logo.png" alt="Spady" width="64" height="64" loading="lazy"/><span>難しいデジタルを、<br/>現場で使える形に。</span></a><p>{service.name}<br/><span>本サービスはMeta社の公式サービスではありません。</span></p></div><nav aria-label="事業者情報・各種方針">{service.links.map(link=><a href={link.href}>{link.label}</a>)}<button type="button" data-cookie-settings>Cookie設定</button></nav><div class="footer-bottom"><small>© {new Date().getFullYear()} Spady</small><a href="#main">ページ上部へ ↑</a></div></div></footer>
  <div class="sticky-cta" id="setupSticky" hidden><Cta placement="sticky" compact/></div>
  <SiteConsent/>
  <script>import '../scripts/meta-ads-setup';</script>
</body></html>
