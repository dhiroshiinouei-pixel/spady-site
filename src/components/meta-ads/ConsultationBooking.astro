---
import {metaAdsSetup as service, industries, restrictions} from '../../data/meta-ads-setup';
const acceptingBookings = service.booking.enabled && !import.meta.env.DEV;
---
<div class="consultation-booking" id="setupReservation" data-accepting={String(acceptingBookings)}>
  <div class="reservation-heading"><p class="eyebrow">ONLINE CONSULTATION</p><h3><span class="phrase">ご都合のよい日時を、</span><span class="phrase">こちらで予約できます。</span></h3><p>{service.consultationHours}／事前相談30分</p></div>
  <ol class="reservation-steps" aria-label="予約の手順"><li><span>1</span> 日時を選ぶ</li><li><span>2</span> ご連絡先を入力</li><li><span>3</span> 予約を確定</li></ol>
  {!acceptingBookings&&<p class="reservation-notice">開発プレビュー：予約受付は停止しています。実際の予約は作成されません。</p>}
  <section class="reservation-calendar" aria-labelledby="setupDateHeading">
    <div class="reservation-section-heading"><h4 id="setupDateHeading">相談日時を選択</h4><span>日本時間</span></div>
    <p id="setupAvailabilityStatus" class="reservation-status" role="status" aria-live="polite">空き状況を確認しています…</p>
    <div id="setupCalendarChoices" class="reservation-calendar-choices" hidden>
      <div class="reservation-days"><p id="setupCalendarMonth" class="reservation-month"></p><div class="reservation-weekdays" aria-hidden="true">{['日','月','火','水','木','金','土'].map(day=><span>{day}</span>)}</div><div id="setupCalendarDays" class="reservation-day-grid" role="group" aria-label="予約できる日付"></div><p class="reservation-help">数字のある枠から、日付をお選びください。</p></div>
      <div class="reservation-times"><p id="setupTimesHeading" class="reservation-month">日付を選択してください</p><div id="setupTimeSlots" class="reservation-time-grid" role="group" aria-labelledby="setupTimesHeading"></div></div>
    </div>
    <button id="setupAvailabilityReload" class="reservation-reload" type="button" hidden>空き状況を再確認する</button>
  </section>
  <form id="setupBookingForm" method="POST" action={service.booking.intakeEndpoint} hidden>
    <input type="hidden" name="form_version" value={service.booking.version}/><input type="hidden" name="topic" value={service.name}/><input type="hidden" name="form_started_at" value=""/><input type="hidden" name="id" value=""/>
    <div class="reservation-trap" aria-hidden="true"><label>この項目は空のままにしてください<input name="website" tabindex="-1" autocomplete="off"/></label></div>
    <p id="setupSelectedTime" class="reservation-selection" aria-live="polite"></p>
    <fieldset id="setupPersonalFields" class="reservation-personal"><legend>ご連絡先と現在の状況</legend><p class="reservation-help">権限・素材・予算などの詳細は、事前相談で確認します。<span class="reservation-required">必須</span> の項目をご入力ください。</p>
      <div class="reservation-field"><label for="setup-company">会社名・屋号・教室名・店舗名 <span class="reservation-required">必須</span></label><input id="setup-company" name="company" autocomplete="organization" maxlength="100" required/></div>
      <div class="reservation-pair"><div class="reservation-field"><label for="setup-name">お名前 <span class="reservation-required">必須</span></label><input id="setup-name" name="name" autocomplete="name" maxlength="100" required/></div><div class="reservation-field"><label for="setup-email">メールアドレス <span class="reservation-required">必須</span></label><input id="setup-email" name="email" type="email" autocomplete="email" maxlength="200" required placeholder="example@company.jp"/></div></div>
      <div class="reservation-field"><label for="setup-industry">業種 <span class="reservation-required">必須</span></label><select id="setup-industry" name="industry" required><option value="">選択してください</option>{industries.map(item=><option>{item}</option>)}</select></div>
      <div class="reservation-account"><p class="reservation-help">制限歴が「あり」という回答だけで、お断りすることはありません。現在の状態と合わせて個別に確認します。</p>
        {[['restriction_current','現在の広告アカウント等の制限'],['restriction_history','過去の停止・制限・ペナルティ']].map(([name,label])=><fieldset class="reservation-radio"><legend>{label} <span class="reservation-required">必須</span></legend><div>{restrictions.map(item=><label><input type="radio" name={name} value={item} required/><span>{item}</span></label>)}</div></fieldset>)}
      </div>
      <details class="reservation-optional"><summary>Webサイト・ご相談内容を追加する <span>任意</span></summary><div class="reservation-field"><label for="setup-url">WebサイトまたはLPのURL</label><input id="setup-url" name="site_url" type="url" inputmode="url" maxlength="2000" placeholder="https://"/></div><div class="reservation-field"><label for="setup-message">ご相談内容</label><textarea id="setup-message" name="message" rows="3" maxlength="4000" placeholder="お困りのことやご希望があれば、お知らせください。"></textarea></div></details>
      <fieldset class="reservation-agreements"><legend>ご予約前の確認 <span class="reservation-required">すべて必須</span></legend>
        <label><input type="checkbox" name="pixel_scope" value="yes" required/><span>Pixelは作成・基本コード提供までです。サイト設置・イベント計測・動作確認は別料金となることを確認しました。</span></label>
        <label><input type="checkbox" name="no_recovery" value="yes" required/><span>アカウント制限の復旧や異議申し立てには対応していないことを確認しました。</span></label>
        <label><input type="checkbox" name="consent" value="yes" required/><span><a href="/privacy/" target="_blank" rel="noopener">プライバシーポリシー<span class="sr-only">（新しいタブで開きます）</span></a>に同意します。</span></label>
      </fieldset>
    </fieldset>
    <button id="setupBookingSubmit" class="reservation-submit" type="submit" disabled>この日時で相談を予約する <span aria-hidden="true">→</span></button>
    <p class="reservation-help reservation-submit-note">{service.ctaNote}</p>
    <p class="reservation-help">入力した連絡先は、相談の事前確認とカレンダーのご案内に使用します。パスワード・二段階認証コード・カード情報は入力しないでください。</p>
  </form>
  <div id="setupBookingStatus" class="reservation-result" role="status" aria-live="polite" tabindex="-1" hidden></div>
  <section id="setupBookingComplete" class="reservation-complete" aria-labelledby="setupCompleteHeading" tabindex="-1" hidden><span class="reservation-complete-icon" aria-hidden="true">✓</span><h4 id="setupCompleteHeading">相談のご予約が確定しました。</h4><p id="setupConfirmedTime" class="reservation-confirmed-time"></p><p>当日は、こちらのLarkミーティングにご参加ください。</p><a id="setupLarkMeeting" class="reservation-meeting-link" target="_blank" rel="noopener noreferrer">Larkミーティングを開く <span aria-hidden="true">↗</span><span class="sr-only">（新しいタブで開きます）</span></a><p class="reservation-help">予約日時と参加URLは、カレンダーからのご案内でもご確認いただけます。</p></section>
  <p class="reservation-footnote">こちらは初期設定前の事前相談です。サービスに含まれる45分の操作説明とは別の時間です。</p>
  <noscript><p class="reservation-notice">日時の選択・予約にはJavaScriptが必要です。JavaScriptを有効にしてご利用ください。予約はまだ完了していません。</p></noscript>
</div>
<style>
  .consultation-booking{min-width:0;padding:42px;background:#fff;border:1px solid #d6dcde;border-top:2px solid #152536;border-radius:0;color:#152536}
  .reservation-heading h3{font-size:clamp(1.25rem,2.3vw,1.65rem);line-height:1.7;margin:13px 0 14px;letter-spacing:.01em;font-weight:650}
  .reservation-heading>p:last-child{font-size:.9375rem;color:#56636b}
  .reservation-steps{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;padding:28px 0;margin:0;border-bottom:1px solid #d6dcde;font-size:.875rem;font-weight:550}
  .reservation-steps li{display:flex;align-items:baseline;gap:10px;min-width:0}.reservation-steps li>span{color:#235c91;font-family:Arial,sans-serif;font-size:.8125rem;font-weight:500;letter-spacing:.05em;flex-shrink:0}.reservation-steps li>span::before{content:"0"}
  .reservation-calendar{padding:32px 0}.reservation-section-heading{display:flex;align-items:center;justify-content:space-between;gap:16px}.reservation-section-heading h4{margin:0;font-size:1.05rem;font-weight:650}.reservation-section-heading>span{font-size:.875rem;color:#56636b;flex-shrink:0}
  .reservation-status{font-size:.9375rem;line-height:1.9;margin:16px 0}.reservation-calendar-choices{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:32px;margin-top:26px}.reservation-days,.reservation-times{min-width:0}.reservation-month{font-size:.9375rem;font-weight:650;margin-bottom:17px}
  .reservation-weekdays,.reservation-day-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:5px}.reservation-weekdays{margin-bottom:10px;font-size:.8125rem;text-align:center;color:#56636b}.reservation-day-grid :global(button){border:1px solid #c6d0d7;background:#f7f9fa;min-height:44px;border-radius:2px;font-size:.9375rem;font-weight:550;color:#235c91;padding:4px 0;transition:background .16s,border-color .16s}.reservation-day-grid :global(button:disabled){background:transparent;border-color:transparent;color:#8c969e;opacity:1;cursor:default}.reservation-day-grid :global(button[aria-pressed="true"]){background:#235c91;border-color:#235c91;color:#fff}.reservation-day-grid :global(button:not(:disabled):hover){border-color:#235c91}
  .reservation-time-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.reservation-time-grid :global(button){padding:10px 3px;min-height:44px;background:#fff;border:1px solid #b3c1cb;border-radius:2px;color:#235c91;font-weight:550;font-size:.875rem;transition:background .16s,border-color .16s}.reservation-time-grid :global(button:not(:disabled):hover){border-color:#235c91;background:#f1f5f8}.reservation-time-grid :global(button[aria-pressed="true"]),.reservation-time-grid :global(button[aria-pressed="true"]:hover){background:#235c91;border-color:#235c91;color:#fff}.reservation-time-grid :global(button:disabled){color:#8c969e;border-color:#e0e5e8;background:#f6f7f7;opacity:1;cursor:default}
  .reservation-reload{min-height:44px;padding:10px 16px;margin-top:10px;border:1px solid #aebdc7;border-radius:2px;background:#fff;color:#235c91;font-size:.875rem;font-weight:550}.reservation-reload:hover{background:#f1f5f8}
  .reservation-help,.reservation-footnote{font-size:.875rem;line-height:1.9;color:#56636b}.reservation-days>.reservation-help{margin-top:14px}.reservation-trap{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
  .reservation-selection{background:#f1f5f8;border-left:2px solid #235c91;padding:17px 20px;font-size:1rem;font-weight:650;margin-bottom:32px;white-space:pre-line}
  .reservation-personal,.reservation-radio,.reservation-agreements{min-width:0;margin:0;padding:0;border:0}.reservation-personal>legend{font-size:1.05rem;font-weight:650;padding:0;margin-bottom:14px}.reservation-personal>.reservation-help{margin-bottom:28px}.reservation-field{margin:0 0 24px}.reservation-field>label{display:block;margin-bottom:9px;font-size:.9375rem;font-weight:550;line-height:1.8}.reservation-field input,.reservation-field select,.reservation-field textarea{box-sizing:border-box;width:100%;max-width:100%;min-height:50px;padding:12px 13px;border:1px solid #aebbc4;border-radius:2px;background:#fff;color:#152536;font-size:1rem;line-height:1.5}.reservation-field textarea{resize:vertical}.reservation-field input::placeholder,.reservation-field textarea::placeholder{color:#687984;opacity:1}.reservation-pair{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px}.reservation-required{display:inline-block;padding:0 0 0 6px;color:#56636b;font-size:.75rem;font-weight:450;vertical-align:middle;white-space:nowrap}
  .reservation-account{margin:8px 0 28px;padding:24px;background:#f5f5f2}.reservation-account>.reservation-help{margin-bottom:22px}.reservation-radio+.reservation-radio{margin-top:22px}.reservation-radio legend{font-size:.875rem;font-weight:550;line-height:1.8;padding:0;margin-bottom:10px}.reservation-radio>div{display:flex;flex-wrap:wrap;gap:8px}.reservation-radio label{display:flex;align-items:center;gap:8px;min-height:44px;padding:9px 13px;border:1px solid #c7cfd4;border-radius:2px;background:#fff;font-size:.875rem;cursor:pointer}.reservation-radio label:has(input:checked){border-color:#235c91;background:#f1f5f8}.reservation-radio input,.reservation-agreements input{accent-color:#235c91;width:18px;height:18px;flex:0 0 18px;margin:0}
  .reservation-optional{margin:28px 0}.reservation-optional>summary{min-height:44px;cursor:pointer;font-size:.9375rem;font-weight:550;padding:10px 0}.reservation-optional>summary>span{font-size:.8125rem;color:#56636b;margin-left:5px}.reservation-optional[open]>summary{margin-bottom:18px}.reservation-agreements{border-top:1px solid #d6dcde;padding:24px 0 0;margin-top:28px}.reservation-agreements>legend{font-size:.9375rem;font-weight:650;padding-right:12px}.reservation-agreements>label{display:flex;align-items:flex-start;gap:12px;font-size:.875rem;line-height:1.9;margin:14px 0;cursor:pointer}.reservation-agreements input{margin-top:4px}.reservation-agreements a{color:#235c91;text-decoration:underline;text-underline-offset:3px}.reservation-submit{display:flex;align-items:center;justify-content:center;gap:20px;width:100%;min-height:60px;padding:17px 22px;margin-top:30px;border:1px solid #235c91;border-radius:2px;background:#235c91;color:#fff;font-size:1rem;font-weight:650;line-height:1.7;transition:background .16s,border-color .16s}.reservation-submit:hover:not(:disabled){background:#19476e;border-color:#19476e}.reservation-submit:disabled{background:#e4e8eb;border-color:#d6dcde;color:#56636b;opacity:1;cursor:not-allowed}.reservation-submit-note{text-align:center;margin:14px 0}.reservation-footnote{margin-top:30px;padding-top:23px;border-top:1px solid #d6dcde}
  .reservation-result{padding:20px;margin:24px 0 0;background:#f1f5f8;border-left:2px solid #235c91;white-space:pre-line;font-size:.9375rem;line-height:1.9}.reservation-result[data-state="error"],.reservation-notice{background:#faf6ef;border-color:#ac753a;color:#694d28}.reservation-notice{padding:18px;margin:24px 0;border-left:2px solid #ac753a;font-size:.875rem}
  .reservation-complete{padding:34px 0 8px;text-align:center}.reservation-complete-icon{display:block;color:#21644b;font-size:1.75rem;margin:0 auto 18px;line-height:1.2}.reservation-complete h4{font-size:1.25rem;margin:0 0 20px;line-height:1.7;font-weight:650}.reservation-confirmed-time{font-size:1.1rem;font-weight:650;white-space:pre-line;margin-bottom:22px}.reservation-complete>p{font-size:.9375rem}.reservation-meeting-link{display:inline-flex;gap:15px;align-items:center;justify-content:center;min-height:52px;padding:14px 22px;border:1px solid #235c91;border-radius:2px;color:#235c91;font-weight:650;margin:22px 0}.reservation-meeting-link:hover{background:#f1f5f8}.reservation-complete>.reservation-help{font-size:.875rem}
  @media(max-width:640px){.consultation-booking{padding:28px 20px}.reservation-steps{gap:15px;font-size:.8125rem;padding-block:23px}.reservation-steps li{display:block}.reservation-steps li>span{display:block;margin-bottom:6px}.reservation-calendar-choices{grid-template-columns:minmax(0,1fr);gap:28px}.reservation-day-grid{gap:5px}.reservation-time-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.reservation-pair{grid-template-columns:minmax(0,1fr);gap:0}.reservation-account{padding:20px 14px}.reservation-radio label{padding:8px 9px}.reservation-submit{font-size:.9375rem;gap:12px;padding-inline:10px}.reservation-selection{font-size:.9375rem;padding:16px}.reservation-calendar{padding-top:26px}}
  @media(max-width:359px){.consultation-booking{padding-inline:16px}.reservation-steps{gap:10px;font-size:.8125rem}.reservation-time-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.reservation-radio label{font-size:.875rem;padding-inline:8px}.reservation-radio>div{gap:8px}.reservation-heading h3{font-size:1.2rem}}
  @media(prefers-reduced-motion:reduce){.reservation-day-grid :global(button),.reservation-time-grid :global(button),.reservation-submit{transition:none}}
</style>
