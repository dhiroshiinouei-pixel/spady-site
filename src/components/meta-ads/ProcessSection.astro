---
import { metaAdsSetup as service, steps } from '../../data/meta-ads-setup';
---

<section id="flow" class="section process-section" aria-labelledby="process-heading">
  <div class="wrap">
    <header class="process-heading">
      <div>
        <p class="section-label">06 <span>ご利用の流れ</span></p>
        <h2 id="process-heading"><span>まずは状況を確認。</span><span>その後に、正式なお申込み。</span></h2>
      </div>
      <p class="process-intro">事前確認を行ってから、正式なお手続きをご案内します。<span>事前相談のご予約は、サービスの契約やお支払いのお手続きではありません。</span></p>
    </header>

    <ol class="process-road">
      {steps.map(([title, text], index) => (
        <li class="process-stage">
          <div class="process-picture" aria-hidden="true">
            <svg viewBox="0 0 96 96" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
              {index === 0 && <>
                <rect x="16" y="22" width="62" height="57" rx="5" fill="#fff"/>
                <path d="M16 37h62M31 16v13m32-13v13"/>
                <path d="M29 48h7m10 0h7m10 0h3M29 61h7m10 0h7" stroke="#a5b4c0"/>
                <circle cx="69" cy="71" r="16" fill="#235c91" stroke="#235c91"/>
                <path d="m62 71 5 5 9-11" stroke="#fff" stroke-width="3"/>
              </>}
              {index === 1 && <>
                <rect x="13" y="20" width="65" height="49" rx="4" fill="#fff"/>
                <path d="M13 31h65M36 69v10m-10 0h35"/>
                <circle cx="32" cy="45" r="6" fill="#e7ecef"/>
                <path d="M23 60c1-10 17-10 18 0M49 43h15m-15 8h8" stroke="#7a8f9f"/>
                <circle cx="68" cy="63" r="13" fill="#f1f3f4" stroke="#235c91" stroke-width="3"/>
                <path d="m78 73 9 9" stroke="#235c91" stroke-width="4"/>
              </>}
              {index === 2 && <>
                <path d="M27 16h30l15 15v50H27z" fill="#fff"/>
                <path d="M57 16v16h15M37 43h23m-23 11h17m-17 11h10" stroke="#7a8f9f"/>
                <path d="m58 65 18-23 8 7-18 23-12 4z" fill="#e7ecef" stroke="#235c91"/>
                <path d="m74 45 8 7m-24 13 8 7" stroke="#235c91"/>
                <circle cx="24" cy="27" r="11" fill="#235c91" stroke="#235c91"/>
                <path d="m19 27 4 4 7-8" stroke="#fff" stroke-width="2.5"/>
              </>}
              {index === 3 && <>
                <rect x="13" y="21" width="66" height="58" rx="5" fill="#fff"/>
                <path d="M13 33h66M23 27h2m5 0h2" stroke="#7a8f9f"/>
                <rect x="23" y="43" width="25" height="24" rx="2" fill="#e7ecef" stroke="#235c91"/>
                <path d="m24 62 8-8 6 6 5-4 5 5M56 46h13m-13 9h10m-10 9h7" stroke="#7a8f9f"/>
                <circle cx="74" cy="72" r="15" fill="#235c91" stroke="#235c91"/>
                <path d="M67 72h14m-6-6 6 6-6 6" stroke="#fff" stroke-width="2.7"/>
              </>}
              {index === 4 && <>
                <rect x="10" y="19" width="62" height="44" rx="4" fill="#fff"/>
                <path d="M34 63v11m-12 0h27"/>
                <circle cx="41" cy="34" r="7" fill="#e7ecef" stroke="#235c91"/>
                <path d="M29 54c1-15 23-15 24 0" fill="#e7ecef" stroke="#235c91"/>
                <path d="M56 47c9-3 19-3 28 1v33c-9-4-19-4-28-1z" fill="#f1f3f4" stroke="#235c91"/>
                <path d="M63 54h13m-13 8h13m-13 8h8" stroke="#235c91"/>
              </>}
            </svg>
            <span class="process-number">0{index + 1}</span>
          </div>
          <div class="process-copy">
            <h3>{title}</h3>
            <p class="process-description">{text}</p>
            {index === 4 && <span class="process-duration">画面共有で {service.lectureMinutes}分</span>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process-section{background:#f5f5f2;border-block:1px solid #dde0df}
  .process-heading{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);align-items:end;gap:56px;margin-bottom:52px}
  .process-heading h2{font-size:clamp(1.6rem,2.6vw,2.2rem);line-height:1.65;letter-spacing:.01em}
  .process-heading h2>span{display:inline-block;max-width:100%}
  .process-intro{color:#56636b;font-size:.9375rem;line-height:1.9;max-width:440px}
  .process-intro>span{display:block;margin-top:10px;font-size:.875rem}
  .process-road{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:28px}
  .process-stage{min-width:0;border-top:1px solid #adb8bf;padding-top:20px}
  .process-picture{min-height:64px;margin:0 0 23px;color:#152536;display:flex;flex-direction:row-reverse;align-items:center;justify-content:space-between;gap:12px}
  .process-picture svg{width:62px;height:62px;max-width:100%;flex-shrink:0}
  .process-number{color:#235c91;font-family:Arial,sans-serif;font-size:.9375rem;font-weight:500;line-height:1;letter-spacing:.08em;font-variant-numeric:tabular-nums}
  .process-copy h3{font-size:1.0625rem;font-weight:650;line-height:1.75;margin:0 0 12px;letter-spacing:0;overflow-wrap:break-word}
  .process-description{font-size:.875rem;line-height:1.95;color:#56636b;overflow-wrap:break-word}
  .process-duration{display:inline-block;padding-top:12px;margin-top:8px;font-size:.875rem;font-weight:550;color:#235c91}
  @media(min-width:781px) and (max-width:1099px){
    .process-heading{grid-template-columns:minmax(0,1fr);gap:20px;margin-bottom:38px}.process-intro{max-width:650px}
    .process-road{grid-template-columns:repeat(6,minmax(0,1fr));gap:36px 28px}
    .process-stage{grid-column:span 2}
    .process-stage:nth-child(n+4){grid-column:span 3}
    .process-copy h3{font-size:1rem}
  }
  @media(max-width:780px){
    .process-heading{grid-template-columns:minmax(0,1fr);gap:20px;margin-bottom:32px}
    .process-heading h2{font-size:1.6rem}
    .process-road{display:block}
    .process-stage{display:grid;grid-template-columns:68px minmax(0,1fr);gap:22px;padding:25px 0}
    .process-stage:last-child{padding-bottom:0}
    .process-picture{margin:0;min-height:0;display:flex;flex-direction:column-reverse;justify-content:flex-end;align-items:flex-start;gap:12px}
    .process-picture svg{width:58px;height:58px}
    .process-number{font-size:.875rem}
    .process-copy h3{font-size:1.0625rem;margin-bottom:9px;line-height:1.75}
    .process-description{font-size:.875rem;line-height:1.9}
    .process-duration{margin-top:4px;padding-top:8px}
  }
  @media(max-width:389px){
    .process-stage{grid-template-columns:50px minmax(0,1fr);gap:18px}
    .process-picture svg{width:48px;height:48px}
    .process-heading h2{font-size:1.5rem}
  }
</style>
