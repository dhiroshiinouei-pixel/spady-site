---
import { metaAdsActivity as activity } from '../../data/meta-ads-activity';
---

<section id="community-activity" class="community-activity" aria-labelledby="community-activity-title">
  <div class="wrap activity-layout">
    <header class="activity-heading">
      <p class="activity-eyebrow">{activity.eyebrow}</p>
      <h2 id="community-activity-title">{activity.heading.map(part => <span>{part}</span>)}</h2>
      <p class="activity-description">{activity.description}</p>
    </header>
    <figure class="activity-photo">
      <img
        src={activity.image.src}
        width={activity.image.width}
        height={activity.image.height}
        alt={activity.image.alt}
        loading="lazy"
        decoding="async"
      />
      <figcaption>{activity.image.caption}</figcaption>
    </figure>
    <div class="activity-evidence">
      <div class="activity-followers">
        <p class="activity-fact-label" aria-hidden="true">{activity.followers.label}</p>
        <p class="activity-follower-value">
          <span class="sr-only">{activity.followers.accessibleResult}</span>
          <strong aria-hidden="true">{activity.followers.value}</strong>
          <span aria-hidden="true">{activity.followers.unit}</span>
          <span class="activity-change" aria-hidden="true">{activity.followers.change}</span>
        </p>
      </div>
      <div class="activity-reservation">
        <p class="activity-fact-label">{activity.reservation.label}</p>
        <p class="activity-reservation-text">{activity.reservation.text}</p>
      </div>
      <p class="activity-note">{activity.note}</p>
      <a href={activity.link.href} class="activity-link">
        {activity.link.label}<span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .community-activity{padding-block:84px;background:#fff;border-top:1px solid #d8dddf;color:#152536}
  .activity-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);grid-template-areas:"photo heading" "photo evidence";gap:25px 56px;align-items:start}
  .activity-heading{grid-area:heading;min-width:0}
  .activity-eyebrow{margin-bottom:13px;color:#52616c;font-size:.875rem;font-weight:500;letter-spacing:.035em}
  .activity-heading h2{font-size:clamp(1.625rem,2.35vw,2.125rem);font-weight:650;line-height:1.6;letter-spacing:.035em;overflow-wrap:normal}
  .activity-heading h2>span{display:inline-block;max-width:100%}
  .activity-description{margin-top:17px;font-size:.9375rem;line-height:1.95;color:#52616c}
  .activity-photo{grid-area:photo;margin:0;min-width:0;padding-top:4px;align-self:center}
  .activity-photo img{width:100%;height:auto;aspect-ratio:4/3;object-fit:cover}
  .activity-photo figcaption{margin-top:11px;font-size:.875rem;line-height:1.8;color:#52616c}
  .activity-evidence{grid-area:evidence;min-width:0;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:0 23px;border-top:1px solid #aeb8be}
  .activity-followers{min-width:0;padding:20px 0 19px}
  .activity-fact-label{font-size:.875rem;font-weight:500;line-height:1.8;color:#52616c}
  .activity-follower-value{display:flex;align-items:baseline;flex-wrap:wrap;gap:2px 6px;line-height:1.5;color:#235c91;margin-top:8px}
  .activity-follower-value strong{font-size:2.625rem;font-weight:650;letter-spacing:-.035em;line-height:1.25;font-variant-numeric:tabular-nums}
  .activity-follower-value>span:not(.sr-only){font-size:.9375rem;font-weight:550;white-space:nowrap}
  .activity-follower-value>span.activity-change{flex-basis:100%;color:#152536;font-size:.875rem;font-weight:500}
  .activity-reservation{min-width:0;padding:20px 0 19px}
  .activity-reservation-text{margin-top:8px;font-size:1rem;font-weight:550;line-height:1.85;text-wrap:pretty}
  .activity-note{grid-column:1/-1;padding-top:17px;border-top:1px solid #d8dddf;font-size:.875rem;line-height:1.9;color:#52616c}
  .activity-link{grid-column:1/-1;justify-self:start;display:inline-flex;align-items:center;gap:22px;min-height:44px;margin-top:13px;border-bottom:1px solid #a2b0bb;color:#235c91;font-size:.9375rem;font-weight:550;line-height:1.7}
  .activity-link:hover{color:#152536;border-bottom-color:currentColor}
  @media(max-width:1090px){
    .activity-layout{gap:23px 36px}
    .activity-heading h2{font-size:1.875rem}
    .activity-evidence{column-gap:20px}
    .activity-follower-value strong{font-size:2.25rem}
  }
  @media(max-width:800px){
    .community-activity{padding-block:64px}
    .activity-layout{grid-template-columns:minmax(0,1fr);grid-template-areas:"heading" "photo" "evidence";gap:27px;max-width:760px}
    .activity-heading h2{font-size:1.875rem}
    .activity-photo{padding-top:0}
    .activity-photo img{max-height:460px;object-position:center}
    .activity-follower-value strong{font-size:2.625rem}
    .activity-evidence{max-width:100%}
  }
  @media(max-width:600px){
    .community-activity{padding-block:50px}
    .activity-layout{gap:24px}
    .activity-eyebrow{margin-bottom:11px;letter-spacing:.025em}
    .activity-heading h2{font-size:1.625rem;line-height:1.65;letter-spacing:.015em}
    .activity-description{margin-top:15px;font-size:.9375rem;line-height:1.95}
    .activity-photo figcaption{margin-top:10px}
    .activity-evidence{grid-template-columns:minmax(0,1fr);gap:0}
    .activity-followers{padding:18px 0}
    .activity-follower-value{column-gap:6px;margin-top:5px}
    .activity-follower-value strong{font-size:2.5rem}
    .activity-follower-value>span.activity-change{flex-basis:auto}
    .activity-reservation{padding:17px 0 18px;border-top:1px solid #d8dddf}
    .activity-reservation-text{margin-top:5px;font-size:1rem;line-height:1.85}
    .activity-note{padding-top:16px}
    .activity-link{margin-top:13px}
  }
</style>
