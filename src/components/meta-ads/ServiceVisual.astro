---
import Icon from './Icon.astro';
import { metaAdsSetup as service } from '../../data/meta-ads-setup';
import type { SupportVisualKind } from '../../data/meta-ads-visuals';
interface Props { kind: SupportVisualKind }
const { kind } = Astro.props;
---

<!-- 本文と重複する説明図。公式素材以外はSpady独自のイメージです。 -->
<div class:list={['service-visual', `service-visual-${kind}`]} aria-hidden="true">
  {kind === 'accounts' && <div class="account-diagram">
    <div class="diagram-origin"><Icon name="settings"/><strong>広告の環境</strong></div>
    <span class="diagram-arrow"><Icon name="arrow"/></span>
    <div class="account-destinations">
      <span><Icon name="ad"/><b>広告アカウント</b></span>
      <span><img src="/meta-ads-setup/brands/facebook-logo-primary-160.png" alt="" width="32" height="32" loading="lazy" decoding="async"/><b>Facebook<wbr/>ページ</b></span>
      <span><img src="/meta-ads-setup/brands/instagram-glyph-gradient-160.png" alt="" width="32" height="32" loading="lazy" decoding="async"/><b>Instagram<small>必要に応じて</small></b></span>
    </div>
  </div>}

  {kind === 'ad' && <div class="ad-diagram">
    <div class="ad-material">
      <svg class="material-picture" viewBox="0 0 96 60" fill="none"><rect x="1" y="1" width="94" height="58" stroke="currentColor"/><circle cx="71" cy="18" r="6" stroke="currentColor"/><path d="m7 53 24-29 22 25 13-15 24 19" stroke="currentColor" stroke-linejoin="round"/></svg>
      <span>画像・動画1点<br/>＋広告文</span>
      <small>お客様がご用意</small>
    </div>
    <span class="diagram-arrow"><Icon name="arrow"/></span>
    <div class="ad-document"><div class="ad-document-title">最初の広告 <b>1件</b></div><div class="ad-image" role="presentation"><Icon name="ad"/></div><i></i><i></i><span>目的・地域・予算</span></div>
  </div>}

  {kind === 'pixel' && <div class="pixel-diagram">
    <div class="pixel-step"><div class="code-window"><Icon name="code"/></div><strong>Meta Pixel<br/>作成</strong></div>
    <span class="diagram-arrow"><Icon name="arrow"/></span>
    <div class="pixel-step"><div class="code-sheet"><Icon name="code"/></div><strong>基本コード<br/>お渡し</strong></div>
    <p class="pixel-extra">サイト設置・イベント設定・動作確認も<br/>レクチャー時に対応できる場合があります</p>
  </div>}

  {kind === 'lesson' && <div class="share-diagram">
    <div class="share-heading"><span>オンラインの画面共有</span><b>{service.lectureMinutes}<small>分</small></b></div>
    <div class="share-screen"><div><Icon name="eye"/><span>見る</span></div><div><Icon name="sliders"/><span>変更する</span></div><div><Icon name="pause"/><span>停止・再開</span></div></div>
    <div class="screen-base"></div>
  </div>}

  {kind === 'check' && <div class="check-diagram"><span class="check-heading">配信前の確認項目</span><div><Icon name="check"/><span>予算・配信地域</span></div><div><Icon name="check"/><span>リンク先</span></div><div><Icon name="check"/><span>入稿内容</span></div></div>}

  {kind === 'guide' && <div class="guide-diagram"><div class="guide-cover"><span>Spady</span><Icon name="guide"/><strong>共通の<br/>操作ガイド</strong></div><div class="guide-contents"><span>予算変更</span><span>停止・再開</span><span>数字の確認</span><small>後から振り返るために</small></div></div>}
</div>

<style>
  .service-visual{display:grid;place-items:center;min-height:215px;padding:24px 18px;color:#235c91;line-height:1.7;width:100%;background:#edeeeb}
  .service-visual :global(svg){display:block;width:25px;height:25px;flex-shrink:0;stroke-width:1.4}
  .service-visual strong,.service-visual b{font-weight:550;color:#152536}
  .diagram-arrow{display:grid;place-items:center;color:#87949e}
  .diagram-arrow :global(svg){width:20px;height:20px;stroke-width:1}
  .account-diagram{display:grid;grid-template-columns:minmax(70px,.8fr) 22px minmax(0,1.4fr);gap:10px;align-items:center;width:100%;max-width:350px}
  .diagram-origin{display:flex;flex-direction:column;align-items:center;gap:12px;text-align:center}
  .diagram-origin :global(svg){width:37px;height:37px;stroke-width:1.2}
  .diagram-origin strong{font-size:.875rem}
  .account-destinations{display:grid;gap:12px;min-width:0}
  .account-destinations>span{display:flex;align-items:center;gap:12px;padding-block:4px;min-width:0}
  .account-destinations img{width:28px;height:28px;flex:0 0 28px;object-fit:contain}
  .account-destinations>span>:global(svg){width:28px;height:28px;flex:0 0 28px}
  .account-destinations b{font-size:.875rem;line-height:1.6}
  .account-destinations small{display:block;color:#596570;font-size:.875rem;font-weight:400}
  .ad-diagram{display:grid;grid-template-columns:minmax(0,1fr) 22px minmax(0,1.1fr);gap:14px;align-items:center;width:100%;max-width:330px}
  .ad-material{text-align:center;min-width:0}
  .ad-material .material-picture{width:92px;max-width:100%;height:auto;margin:0 auto 9px;color:#8094a3}
  .ad-material>span{font-size:.875rem;display:block;color:#152536}
  .ad-material>small{font-size:.875rem;color:#596570;display:block;margin-top:6px}
  .ad-document{border:1px solid #aebbc2;background:#f9f9f7;padding:12px;min-width:0}
  .ad-document-title{font-size:.875rem;color:#152536;line-height:1.5}
  .ad-document-title b{display:inline-block;margin-left:4px;color:#235c91}
  .ad-image{display:grid;place-items:center;background:#e1e7e9;min-height:62px;margin-top:9px;color:#7b91a1}
  .ad-document>i{display:block;height:3px;background:#bdc8cd;margin-top:9px;width:90%}
  .ad-document>i+i{margin-top:5px;width:65%}
  .ad-document>span{font-size:.875rem;display:block;margin-top:9px;color:#596570;line-height:1.6}
  .pixel-diagram{display:grid;grid-template-columns:minmax(0,1fr) 22px minmax(0,1fr);gap:16px;align-items:center;max-width:315px;width:100%}
  .pixel-step{text-align:center;min-width:0}
  .pixel-step strong{font-size:.875rem;display:block;margin-top:10px}
  .code-window,.code-sheet{display:grid;place-items:center;margin-inline:auto;border:1px solid #95a8b4;background:#f9f9f7}
  .code-window{width:88px;max-width:100%;height:62px;border-top-width:6px}
  .code-sheet{width:48px;height:62px}
  .code-window :global(svg),.code-sheet :global(svg){width:28px;height:28px}
  .pixel-extra{grid-column:1/-1;border-top:1px solid #c5ced2;padding-top:11px;margin-top:2px;color:#596570;font-size:.875rem;text-align:center;line-height:1.8}
  .share-diagram{width:100%;max-width:340px}
  .share-heading{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:13px;color:#596570;font-size:.875rem}
  .share-heading b{font-size:1.8rem;font-weight:450;color:#235c91;line-height:1;flex-shrink:0;letter-spacing:-.03em}
  .share-heading small{font-size:.875rem;margin-left:4px;letter-spacing:0}
  .share-screen{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border:1px solid #a9b8c0;background:#f9f9f7;padding:23px 7px 21px;gap:4px}
  .share-screen>div{display:flex;flex-direction:column;align-items:center;gap:13px;min-width:0}
  .share-screen>div+div{border-left:1px solid #d3dadd}
  .share-screen span{font-size:.875rem;color:#152536;text-align:center}
  .share-screen :global(svg){width:24px;height:24px}
  .screen-base{height:13px;width:35%;border-bottom:1px solid #a9b8c0;margin-inline:auto;position:relative}
  .screen-base:before{content:'';height:12px;width:1px;background:#a9b8c0;position:absolute;left:50%;top:0}
  .check-diagram{width:100%;max-width:280px;border:1px solid #b9c4c9;background:#f9f9f7;padding:19px 22px}
  .check-heading{display:block;font-size:.875rem;font-weight:550;color:#152536;margin-bottom:10px}
  .check-diagram>div{display:flex;align-items:center;gap:13px;border-top:1px solid #d9dfe1;padding:9px 0;font-size:.875rem;color:#596570}
  .check-diagram>div :global(svg){width:17px;height:17px;stroke-width:1.5;color:#235c91}
  .guide-diagram{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.25fr);gap:26px;align-items:center;width:100%;max-width:320px}
  .guide-cover{border:1px solid #9bafb9;border-left:4px solid #235c91;padding:14px 12px;background:#f9f9f7;min-width:0}
  .guide-cover>span{font-size:.875rem;color:#596570;letter-spacing:.04em}
  .guide-cover :global(svg){width:30px;height:30px;margin:15px 0}
  .guide-cover strong{font-size:.875rem;line-height:1.8;display:block}
  .guide-contents>span{display:block;font-size:.875rem;padding:7px 0;border-bottom:1px solid #c5ced2;color:#152536}
  .guide-contents>small{display:block;font-size:.875rem;color:#596570;margin-top:12px;line-height:1.8}
  @media(max-width:480px){.service-visual{min-height:205px;padding:22px 16px}.account-diagram{gap:8px;grid-template-columns:minmax(65px,.7fr) 18px minmax(0,1.4fr)}.account-destinations>span{gap:10px}.ad-diagram{gap:10px}.ad-document{padding:10px}.guide-diagram{gap:22px}}
</style>
