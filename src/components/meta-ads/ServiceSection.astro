---
import { metaAdsSetup as service, supports } from '../../data/meta-ads-setup';
import { supportVisuals } from '../../data/meta-ads-visuals';
import Icon from './Icon.astro';
import ReadableText from './ReadableText.astro';
import ServiceVisual from './ServiceVisual.astro';
---

<section id="service" class="section visual-service">
  <div class="wrap">
    <header class="section-heading align-left">
      <p class="section-label">02 <span>サービス内容</span></p>
      <h2><span>{service.price}円に含まれる、</span><span>6つのサポート。</span></h2>
      <p>設定を整える。最初の広告を用意する。<wbr/>基本操作を一緒に確認する。<br class="desktop-break"/>広告を自社で始めるための準備を、順を追ってサポートします。</p>
    </header>

    <div class="support-explainers">
      {supports.map((item, index) => {
        const visual = supportVisuals[index];
        return <article class:list={['support-explainer', { 'support-explainer-pixel': item.caution }]}>
          <span class="support-explainer-number">{item.number}</span>
          <div class="support-explainer-copy">
            <h3>{item.title}</h3>
            <p class="support-explainer-summary">{item.summary}</p>
            <div class="support-explainer-notes">{visual.notes.map(note => <p><ReadableText text={note}/></p>)}</div>
            <details class="support-explainer-details">
              <summary>詳しい対応範囲<span aria-hidden="true"></span></summary>
              <div><p>{item.text}</p><p class="support-explainer-detail-note"><ReadableText text={item.note}/></p></div>
            </details>
          </div>
          <div class="support-explainer-figure"><ServiceVisual kind={visual.kind}/></div>
        </article>;
      })}
    </div>

    <div class="support-ownership"><span><Icon name="shield"/></span><div><h3>アカウントも広告資産も、お客様のもの。</h3><p>必要な権限だけを共有いただきます。決済情報は、お客様ご自身でMetaの画面に入力していただきます。</p></div></div>
    <p class="service-diagram-note">図は作業内容・提供物のイメージです。実際の管理画面・ガイドとは異なります。</p>
  </div>
</section>

<style>
  .visual-service{background:#f5f5f2;color:#152536}
  .visual-service .section-heading{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:18px 72px;align-items:end;margin-bottom:48px}
  .visual-service .section-heading .section-label{grid-column:1/-1;margin-bottom:0}
  .visual-service .section-heading h2{line-height:1.55}
  .visual-service .section-heading>p:last-child{margin:0;max-width:36em;font-size:.9375rem;line-height:1.95}
  .support-explainers{border-top:1px solid #bfc7cb}
  .support-explainer{display:grid;grid-template-columns:46px minmax(0,1fr) minmax(280px,.7fr);gap:32px;align-items:center;min-width:0;padding:44px 0;border-bottom:1px solid #d2d7d8}
  .support-explainer-number{font-size:1.125rem;font-weight:500;letter-spacing:.04em;color:#235c91;align-self:start;padding-top:3px;font-variant-numeric:tabular-nums}
  .support-explainer-copy,.support-explainer-figure{min-width:0}
  .support-explainer h3{font-size:clamp(1.125rem,1.6vw,1.375rem);font-weight:650;line-height:1.7;letter-spacing:0}
  .support-explainer-summary{font-size:.9375rem;line-height:1.9;margin-top:10px}
  .support-explainer-notes{margin-top:17px;color:#596570}
  .support-explainer-notes p{font-size:.875rem;line-height:1.9}
  .support-explainer-notes p+p{margin-top:6px}
  .support-explainer-pixel .support-explainer-notes p:last-child{color:#235c91;font-weight:600}
  .support-explainer-details{margin-top:18px;border-top:1px solid #d2d7d8}
  .support-explainer-details summary{display:flex;align-items:center;justify-content:space-between;gap:15px;min-height:48px;padding:10px 0;cursor:pointer;list-style:none;font-size:.875rem;font-weight:500;color:#235c91}
  .support-explainer-details summary::-webkit-details-marker{display:none}
  .support-explainer-details summary>span{position:relative;flex-shrink:0;width:18px;height:18px}
  .support-explainer-details summary>span:before,.support-explainer-details summary>span:after{content:'';position:absolute;left:3px;top:8px;width:12px;height:1px;background:currentColor}
  .support-explainer-details summary>span:after{transform:rotate(90deg)}
  .support-explainer-details[open] summary>span:after{display:none}
  .support-explainer-details summary:hover{color:#152536}
  .support-explainer-details>div{padding:3px 0 6px;font-size:.9375rem;line-height:1.95}
  .support-explainer-detail-note{margin-top:12px;color:#596570;font-size:.875rem}
  .support-ownership{display:flex;align-items:flex-start;gap:20px;margin-top:34px;max-width:850px}
  .support-ownership>span{color:#235c91;flex-shrink:0;padding-top:4px}
  .support-ownership :global(svg){width:26px;height:26px;stroke-width:1.4}
  .support-ownership h3{font-size:1rem;margin-bottom:5px;line-height:1.7;font-weight:600}
  .support-ownership p{font-size:.875rem;color:#596570;line-height:1.9}
  .service-diagram-note{font-size:.875rem;line-height:1.8;color:#596570;margin-top:22px}
  @media(max-width:1000px){
    .visual-service .section-heading{gap:18px 40px}
    .support-explainer{grid-template-columns:30px minmax(0,1fr) minmax(260px,.75fr);gap:24px}
  }
  @media(max-width:800px){
    .visual-service .section-heading{grid-template-columns:1fr;gap:18px;margin-bottom:34px}
    .visual-service .section-heading .section-label{grid-column:auto}
    .visual-service .section-heading>p:last-child{max-width:42em}
    .support-explainer{grid-template-columns:30px minmax(0,1fr);gap:18px 20px;padding-block:32px;align-items:start}
    .support-explainer-figure{grid-column:2;max-width:460px;width:100%}
    .support-explainer h3{font-size:1.25rem}
  }
  @media(max-width:480px){
    .support-explainer{grid-template-columns:24px minmax(0,1fr);column-gap:14px}
    .support-explainer h3{font-size:1.125rem}
    .support-explainer-figure{grid-column:1/-1;max-width:360px;margin-inline:auto}
    .support-explainer-number{font-size:1rem}
    .support-ownership{gap:13px}
  }
</style>
