---
import { metaAdsResults as results } from '../../data/meta-ads-results';
import Icon from './Icon.astro';
---
<section id="past-results" class="past-results" aria-labelledby="past-results-title">
  <div class="wrap">
    <div class="results-heading">
      <p class="results-eyebrow">{results.eyebrow}</p>
      <h2 id="past-results-title">{results.heading.map(part => <span>{part}</span>)}</h2>
    </div>
    <ul class="results-list">
      {results.cases.map(item => (
        <li>
          <div class="result-context">
            <div class="result-industry"><span class="result-pictogram"><Icon name={item.icon}/></span><h3>{item.industry}</h3></div>
            <p class="result-metric" aria-hidden="true">{item.metric}</p>
          </div>
          <p class="result-value">
            <span class="sr-only">{item.accessibleResult}</span>
            {item.before !== null && <span class="result-before" aria-hidden="true">{item.before}<span class="result-arrow">→</span></span>}
            <strong aria-hidden="true">{item.value}</strong>
            <span class="result-unit" aria-hidden="true">{item.unit}</span>
          </p>
        </li>
      ))}
    </ul>
    <p class="results-note">{results.note}</p>
  </div>
</section>

<style>
  .past-results{padding:60px 0 52px;background:#f5f5f2;color:#152536;border-bottom:1px solid #d8dddf}
  .results-heading{margin-bottom:28px}
  .results-eyebrow{font-size:.875rem;line-height:1.8;font-weight:500;color:#52616c;letter-spacing:.025em;margin-bottom:9px}
  .results-heading h2{font-size:clamp(1.5rem,2.1vw,1.875rem);font-weight:650;line-height:1.6;letter-spacing:.035em;overflow-wrap:normal}
  .results-heading h2>span{display:inline-block;max-width:100%}
  .results-list{list-style:none;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid #aeb8be;border-bottom:1px solid #cdd3d6}
  .results-list>li{min-width:0;padding:24px 26px 26px}
  .results-list>li+li{border-left:1px solid #d8dddf}
  .results-list>li:first-child{padding-left:0}
  .results-list>li:last-child{padding-right:0}
  .result-industry{display:flex;align-items:center;gap:9px}
  .result-pictogram{color:#637887;display:grid;place-items:center;flex:0 0 22px}
  .result-pictogram :global(svg){width:22px;height:22px;stroke-width:1.5}
  .result-context h3{font-size:1rem;font-weight:650;line-height:1.7;letter-spacing:.015em;overflow-wrap:normal}
  .result-metric{font-size:.875rem;line-height:1.7;color:#52616c;margin-top:16px}
  .result-value{display:flex;align-items:baseline;flex-wrap:wrap;gap:1px 6px;color:#235c91;line-height:1.3;margin-top:5px;font-variant-numeric:tabular-nums}
  .result-value strong{font-size:2.75rem;font-weight:650;letter-spacing:-.045em;line-height:1.2}
  .result-unit{font-size:.9375rem;font-weight:550;letter-spacing:0;white-space:nowrap}
  .result-before{font-size:1.5rem;font-weight:500;letter-spacing:-.02em;color:#52616c;display:inline-flex;align-items:baseline;gap:8px}
  .result-arrow{font-size:1.125rem;font-weight:400;color:#7b8a95;margin-right:2px}
  .results-note{font-size:.875rem;line-height:1.9;color:#52616c;margin-top:17px;max-width:940px}
  @media(min-width:901px) and (max-width:1100px){
    .results-list>li{padding-inline:18px}.result-industry{gap:7px}.result-context h3{font-size:.9375rem}.result-pictogram{flex-basis:20px}.result-pictogram :global(svg){width:20px;height:20px}.result-value strong{font-size:2.5rem}
  }
  @media(max-width:900px){
    .results-list{grid-template-columns:repeat(2,minmax(0,1fr))}.results-list>li{padding:23px 28px 24px}.results-list>li:nth-child(odd){padding-left:0;border-left:0}.results-list>li:nth-child(even){padding-right:0}.results-list>li:nth-child(n+3){border-top:1px solid #d8dddf}
  }
  @media(max-width:600px){
    .past-results{padding:40px 0 36px}.results-heading{margin-bottom:23px}.results-heading h2{font-size:1.5rem;line-height:1.6}
    .results-list>li{padding:20px 17px 22px}.result-industry{display:block}.result-pictogram{display:block;margin-bottom:7px}.result-pictogram :global(svg){width:22px;height:22px}
    .result-context h3{font-size:.9375rem;letter-spacing:0}.result-metric{font-size:.875rem;margin-top:11px}.result-value{gap:2px 5px}.result-value strong{font-size:2.5rem}.result-unit{font-size:.875rem}.result-before{font-size:1.375rem;gap:6px}.result-arrow{font-size:1rem}
    .results-note{margin-top:17px;line-height:1.85}
  }
  @media(max-width:359px){
    .results-list>li{padding-inline:14px}.result-value strong{font-size:2.25rem}.result-before{font-size:1.25rem;gap:5px}
  }
</style>
