---
import HomeLayout from '../../layouts/HomeLayout.astro';
import ThreadsLink from '../ThreadsLink.astro';
import { messages, marketingPath, calendarPath, pathFor } from '../../i18n';
import type { Locale } from '../../i18n';
const { lang = 'ja' } = Astro.props as {lang?: Locale};
const t = messages(lang);
const projects = t.projects.map((item,i)=>({...item, number:String(i+1).padStart(2,'0'),
 category:['MARKETING','WEB DESIGN','LEARNING','LOCAL LIFE'][i],
 href:[marketingPath(lang),'https://localpages.spady.net/','/akindo/',calendarPath(lang)][i],
 theme:['blue','yellow','pink','green'][i],
 image:['/home/megaphone.svg','/akindo/assets/local-pages.jpg','/akindo/assets/akindo-venue-20260722.jpg','/home/otaru-calendar-og.jpg'][i]
}));
---
<HomeLayout lang={lang}>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-text"><p class="eyebrow"><span class="signal" aria-hidden="true"></span> LOCAL ROOTS. NEW POSSIBILITIES.</p><h1 id="hero-title" set:html={t.heroTitle} /><p class="hero-description" set:html={t.heroDescription} /><a class="text-link" href="#projects">{t.heroLink} <span class="arrow-circle" aria-hidden="true">↓</span></a></div>
        <div class="hero-visual"><div class="rotating-seal" aria-hidden="true"><svg viewBox="0 0 120 120"><defs><path id="seal-path" d="M60,60m-44,0a44,44 0 1,1 88,0a44,44 0 1,1 -88,0" /></defs><text><textPath href="#seal-path">SPADY · LOCAL &amp; DIGITAL · SPADY · LOCAL &amp; DIGITAL · </textPath></text></svg><span>✳</span></div><img src="/home/coastal-neighborhood.webp" srcset="/home/coastal-neighborhood-900.webp 900w, /home/coastal-neighborhood.webp 1536w" sizes="(max-width:760px) calc(100vw - 42px), 54vw" width="1536" height="1024" alt={t.heroImageAlt} fetchpriority="high" /><div class="hero-image-label"><span class="label-dot" aria-hidden="true"></span> {t.heroImageLabel}</div></div>
        <div class="hero-bottom"><span>BASED IN OTARU / ZENIBAKO, HOKKAIDO</span><a href="#about">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a></div>
      </section>
      <div class="play-ribbon" aria-hidden="true"><div><span>LOCAL <i>✳</i> DIGITAL <i>✳</i> LEARNING <i>✳</i> LIFE <i>✳</i> </span><span>LOCAL <i>✳</i> DIGITAL <i>✳</i> LEARNING <i>✳</i> LIFE <i>✳</i> </span><span>LOCAL <i>✳</i> DIGITAL <i>✳</i> LEARNING <i>✳</i> LIFE <i>✳</i> </span><span>LOCAL <i>✳</i> DIGITAL <i>✳</i> LEARNING <i>✳</i> LIFE <i>✳</i> </span></div></div><section class="about section-shell" id="about" aria-labelledby="about-title"><div class="section-heading"><p class="eyebrow">ABOUT SPADY</p><h2 id="about-title" set:html={t.aboutTitle} /></div><div class="about-copy"><p set:html={t.aboutFirst} /><p>{t.aboutSecond}</p><a class="text-link small-link" href="#profile">{t.profileLink} <span class="arrow-circle" aria-hidden="true">↗</span></a></div></section>
      <section class="projects section-shell" id="projects" aria-labelledby="projects-title"><div class="section-top"><div><p class="eyebrow">OUR PROJECTS</p><h2 id="projects-title" set:html={t.projectsTitle} /></div><p class="section-note" set:html={t.projectsNote} /></div><div class="project-grid">{projects.map(project=>(<a class={`project-card ${project.theme}`} href={project.href}><div class="project-top"><span>{project.number} / {project.category}</span><span class="project-tags">{project.tags}</span></div><div class={`project-art art-${project.theme}${project.theme==='green'?' art-calendar':''}`}><img src={project.image} alt={project.imageAlt} loading="lazy" width="600" height="300" />{project.theme==='blue' && <span class="art-word" aria-hidden="true">CONNECT.</span>}<span class="art-spark" aria-hidden="true">✳</span></div><p class="project-copy">{project.copy}</p><h3>{project.title}</h3><p class="project-description">{project.description}</p>{lang!=='ja' && (project.theme==='yellow'||project.theme==='pink') && <small class="destination-language">{t.japaneseLink}</small>}<div class="project-bottom"><span>{project.link}</span><span class="arrow-circle" aria-hidden="true">↗</span></div></a>))}</div></section>
      <section class="stories-band" id="stories" aria-labelledby="stories-title">
        <div class="section-shell">
          <div class="section-top"><div><p class="eyebrow">WORKS & STORIES</p><h2 id="stories-title" set:html={t.storiesTitle} /></div><p class="section-note" set:html={t.storiesNote} /></div>
          <div class="story-grid">
            <a class="story-card" href="/akindo/#scene"><div class="story-image"><img src="/akindo/assets/akindo-venue-20260722.jpg" width="1456" height="1092" loading="lazy" alt={t.stories[0].alt} /></div><div class="story-meta"><span>LEARNING</span><span>{t.stories[0].location}</span></div><h3 set:html={t.stories[0].title} /><p>{t.stories[0].copy}</p>{lang!=='ja' && <small class="destination-language">{t.japaneseLink}</small>}<span class="story-arrow" aria-hidden="true">↗</span></a>
            <a class="story-card" href="https://localpages.spady.net/#works"><div class="story-image local-pages-image"><img src="/akindo/assets/local-pages.jpg" width="1280" height="720" loading="lazy" alt={t.stories[1].alt} /></div><div class="story-meta"><span>WEB DESIGN</span><span>{t.stories[1].location}</span></div><h3 set:html={t.stories[1].title} /><p>{t.stories[1].copy}</p>{lang!=='ja' && <small class="destination-language">{t.japaneseLink}</small>}<span class="story-arrow" aria-hidden="true">↗</span></a>
            <a class="story-card" href={marketingPath(lang)}><div class="story-image client-image"><img src="/logo-qqenglish.png" width="400" height="140" loading="lazy" alt={t.stories[2].alt} /><span>LINE OFFICIAL ACCOUNT</span></div><div class="story-meta"><span>MARKETING</span><span>{t.stories[2].location}</span></div><h3 set:html={t.stories[2].title} /><p>{t.stories[2].copy}</p><span class="story-arrow" aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
      <section class="topics section-shell" aria-labelledby="topics-title">
        <div><p class="eyebrow">INFORMATION</p><h2 id="topics-title" set:html={t.topicsTitle} /><p class="topics-note">{t.topicsNote}</p></div>
        <div class="topic-list">
          <a href="/akindo/"><span class="topic-tag">{t.topics[0].tag}</span><span>{t.topics[0].text}</span><span class="topic-arrow" aria-hidden="true">↗</span></a>
          <a href="https://localpages.spady.net/#works"><span class="topic-tag">{t.topics[1].tag}</span><span>{t.topics[1].text}</span><span class="topic-arrow" aria-hidden="true">↗</span></a>
          <a href={calendarPath(lang)}><span class="topic-tag">{t.topics[2].tag}</span><span>{t.topics[2].text}</span><span class="topic-arrow" aria-hidden="true">↗</span></a>
        </div>
      </section>
      <section class="profile section-shell" id="profile" aria-labelledby="profile-title">
        <div class="profile-photo"><span class="profile-photo-note">HELLO FROM OTARU.</span><img src="/profile.jpg" width="320" height="320" loading="lazy" alt={t.profileAlt} /><p>{t.tagline}<span>HIROSHI INOUE / SPADY</span></p></div>
        <div class="profile-copy"><p class="eyebrow">PEOPLE BEHIND SPADY</p><h2 id="profile-title" set:html={t.profileTitle} /><p set:html={t.profileIntro} /><div class="profile-name"><h3>{t.profileName}</h3><span>{t.profileRole}</span></div><p class="profile-bio">{t.profileBio}</p><dl class="profile-facts"><div><dt>{t.businessName}</dt><dd>Spady</dd></div><div><dt>{t.base}</dt><dd>{t.location}</dd></div><div><dt>{t.coverage}</dt><dd>{t.coverageValue}</dd></div></dl><div class="profile-threads"><ThreadsLink lang={lang} /><p class="threads-account">{t.threadsNote}<br />@hiroshiinoue.spady</p></div></div>
      </section>
      <section class="contact" id="contact" aria-labelledby="contact-title"><div class="section-shell contact-inner"><div><p class="eyebrow">LET’S TALK</p><h2 id="contact-title" set:html={t.ctaTitle} /><p set:html={t.ctaCopy} /></div><div class="contact-links"><a class="contact-button" href={pathFor(lang,'contact/')}><span class="button-label">{t.contact}</span> <span aria-hidden="true">↗</span></a><a class="contact-line" href="https://s.lmes.jp/landing-qr/2002523511-OZpWpGdr?uLand=O4rFry"><img class="line-icon" src="/home/line.svg" width="26" height="26" alt="" />{t.line} <span aria-hidden="true">↗</span></a><span class="contact-note">{t.contactNote}</span></div></div></section>
    </main>
</HomeLayout>
