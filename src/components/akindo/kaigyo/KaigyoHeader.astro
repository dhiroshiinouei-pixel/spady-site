---
import { kaigyoPages, kaigyoBase } from '../../../data/akindo/site';
const current = Astro.url.pathname;
---
<a class="k-skip" href="#main">本文へ移動</a>
<header class="k-header">
  <div class="k-container k-header-inner">
    <a class="k-brand" href={kaigyoBase} aria-label="AKINDO Lab 開業準備 トップ"><span>AKINDO <span class="k-brand-lab">Lab</span><i aria-hidden="true"></i></span><small>開業準備 <span>小さな商いに、次の一手。</span></small></a>
    <nav class="k-desktop-nav" aria-label="メインナビゲーション">{kaigyoPages.map(item => <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}{item.label === '学ぶ' && <span aria-hidden="true"> ↗</span>}</a>)}</nav>
    <a class="k-button k-header-cta" href={`${kaigyoBase}checklist/`}>無料で始める <span aria-hidden="true">↗</span></a>
    <details class="k-mobile-menu"><summary aria-label="ナビゲーションメニュー"><span class="k-menu-lines" aria-hidden="true"></span><span>メニュー</span></summary><nav aria-label="モバイルナビゲーション">{kaigyoPages.map(item => <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}<span aria-hidden="true">→</span></a>)}<a href={`${kaigyoBase}diagnosis/`}>開業準備診断 <span aria-hidden="true">→</span></a><a class="k-button" href={`${kaigyoBase}checklist/`}>無料で始める</a></nav></details>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.k-mobile-menu');
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { menu.open = false; }));
  menu?.addEventListener('focusout', e => { if (e.relatedTarget instanceof Node && !menu.contains(e.relatedTarget)) menu.open = false; });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && menu?.open) { menu.open = false; menu.querySelector('summary')?.focus(); } });
  document.addEventListener('click', e => { if (menu?.open && e.target instanceof Node && !menu.contains(e.target)) menu.open = false; });
  matchMedia('(min-width: 1100px)').addEventListener('change', e => { if(e.matches && menu) menu.open = false; });
</script>
