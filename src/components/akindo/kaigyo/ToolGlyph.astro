---
import ServiceMark from './ServiceMark.astro';
import { categoryBrands } from '../../../data/akindo/brands';
interface Props { category: string; size?: number; }
const { category, size = 64 } = Astro.props;
const brand = categoryBrands[category];
---
{brand ? <ServiceMark brand={brand} /> : <svg class="tool-glyph" width={size} height={size} viewBox="0 0 64 64" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <circle cx="32" cy="32" r="29" fill="#F2EACD"/>
  <g stroke="#294C3B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    {category === 'accounting' && <><path d="M16 12h30v42H16z" fill="#FFFDF5"/><path d="M22 21h18M22 28h9M22 35h9M22 42h9"/><path d="m35 35 2 2 4-5m-6 10 2 2 4-5"/><path d="M13 17h6m-6 10h6m-6 10h6m-6 10h6" stroke="#AC7A20"/></>}
    {category === 'banking' && <><path d="M12 25 28 14l16 11H12Z" fill="#FFFDF5"/><path d="M16 29v15m8-15v15m8-15v12m8-12v12M11 48h25M10 52h27"/><rect x="34" y="35" width="23" height="16" rx="3" fill="#E8BA4A"/><path d="M35 41h21M39 46h4"/></>}
    {category === 'payment' && <><rect x="17" y="11" width="29" height="43" rx="5" fill="#FFFDF5"/><rect x="22" y="17" width="19" height="14" rx="2" fill="#DDE7D7"/><path d="m27 24 3 3 6-6M23 37h2m7 0h2m7 0h0M23 44h2m7 0h2m7 0h0"/><path d="M40 33h17v13H40z" fill="#E8BA4A"/><path d="M41 38h15"/></>}
    {category === 'reservation' && <><rect x="12" y="17" width="39" height="35" rx="5" fill="#FFFDF5"/><path d="M12 28h39M22 12v10m19-10v10"/><path d="M20 35h4m8 0h4m-16 8h4"/><circle cx="44" cy="43" r="11" fill="#E8BA4A"/><path d="m39 43 3 3 6-7"/></>}
    {category === 'website' && <><rect x="10" y="14" width="44" height="35" rx="4" fill="#FFFDF5"/><path d="M10 24h44M16 19h1m5 0h1m5 0h1"/><path d="M16 30h16v12H16z" fill="#E8BA4A"/><path d="M38 31h9m-9 6h9m-31 17h31M27 49v5m10-5v5"/></>}
    {category === 'crm' && <><path d="M13 16h15l5 5h19v29H13V16Z" fill="#FFFDF5"/><path d="M17 13h28v8"/><circle cx="27" cy="32" r="5" fill="#E8BA4A"/><path d="M18 44c1-8 17-8 18 0m3-13h7m-7 6h7m-7 6h5"/></>}
    {category === 'shop' && <><path d="M14 25h37v28H14z" fill="#FFFDF5"/><path d="m12 25 5-12h31l5 12H12Z" fill="#E8BA4A"/><path d="M12 25c0 7 10 7 10 0 0 7 10 7 10 0 0 7 10 7 10 0 0 7 11 7 11 0M24 14l-2 11m18-11 2 11"/><path d="M21 37h11v16M39 37h6v7h-6z"/></>}
    {category === 'concept' && <><path d="M20 30a12 12 0 1 1 24 0c0 6-6 8-6 14H26c0-6-6-8-6-14Z" fill="#FFFDF5"/><path d="M26 44h12v6H26z" fill="#E8BA4A"/><path d="M28 54h8M32 10V6M14 18l-4-3m40 3 4-3M12 32H7m45 0h5M28 29l4 4 4-4m-4 4v11"/></>}
    {category === 'target' && <><circle cx="30" cy="34" r="20" fill="#FFFDF5"/><circle cx="30" cy="34" r="12" fill="#E8BA4A"/><circle cx="30" cy="34" r="4" fill="#FFFDF5"/><path d="m30 34 19-20m-1-7 1 7 8 1m-9-8-7 7 1 6 7 1 8-6"/></>}
    {category === 'calendar' && <><rect x="12" y="15" width="40" height="38" rx="5" fill="#FFFDF5"/><path d="M12 27h40M22 10v11m20-11v11M20 34h4m6 0h4m6 0h4M20 43h4m6 0h4"/><circle cx="44" cy="43" r="6" fill="#E8BA4A"/></>}
    {category === 'document' && <><path d="M17 10h21l10 10v34H17V10Z" fill="#FFFDF5"/><path d="M38 10v11h10M24 29h16m-16 7h12m-12 7h7"/><circle cx="45" cy="46" r="10" fill="#E8BA4A"/><path d="m40 46 3 3 6-7"/></>}
    {category === 'mail' && <><rect x="10" y="20" width="44" height="31" rx="4" fill="#FFFDF5"/><path d="m12 23 20 15 20-15M12 48l13-13m27 13L39 35"/><circle cx="48" cy="17" r="10" fill="#E8BA4A"/><path d="M48 12v10m-5-5h10"/></>}
    {category === 'megaphone' && <><path d="M12 25h12l24-13v38L24 37H12V25Z" fill="#FFFDF5"/><path d="M24 25v12M16 38l5 15h9l-5-15" fill="#E8BA4A"/><path d="M48 25c8 0 8 13 0 13M55 15l4-3m-4 37 4 3M7 27v8"/></>}
    {category === 'chart' && <><path d="M12 13v40h42"/><path d="M20 39h7v14h-7zm12-9h7v23h-7zm12-11h7v34h-7z" fill="#FFFDF5"/><path d="m17 30 11-9 8 2 14-13m-8 0h8v8" stroke="#AC7A20"/></>}
    {category === 'people' && <><circle cx="25" cy="23" r="8" fill="#FFFDF5"/><path d="M10 50v-5c0-15 30-15 30 0v5H10Z" fill="#FFFDF5"/><path d="M40 15a8 8 0 0 1 0 16m6 6c7 1 10 6 10 13H45"/><path d="m20 43 4 4 7-9" stroke="#AC7A20"/></>}
    {category === 'compass' && <><circle cx="32" cy="33" r="21" fill="#FFFDF5"/><path d="M32 8V5m-3 0h6M32 16v3m0 28v3M15 33h3m28 0h3"/><path d="m41 23-5 14-13 6 5-15 13-5Z" fill="#E8BA4A"/><path d="m28 28 8 9"/></>}
    {category === 'salon' && <><rect x="13" y="10" width="24" height="31" rx="12" fill="#FFFDF5"/><path d="M16 53h20M26 41v12M18 24v-3a7 7 0 0 1 7-7"/><rect x="37" y="31" width="16" height="22" rx="3" fill="#E8BA4A"/><path d="M40 31v-7h10v7m-10-7h16M42 40h6m-6 5h6"/></>}
    {category === 'school' && <><path d="M32 19c-7-5-15-5-23-2v31c8-3 16-3 23 2 7-5 15-5 23-2V17c-8-3-16-3-23 2Z" fill="#FFFDF5"/><path d="M32 19v31M16 25h8m-8 7h8m-8 7h5"/><path d="m39 38 2-8 11-11 6 6-11 11-8 2Z" fill="#E8BA4A"/></>}
    {category === 'visiting' && <><path d="m10 29 21-17 21 17M16 25v28h30V25" fill="#FFFDF5"/><path d="M25 39h10v14"/><circle cx="47" cy="38" r="12" fill="#E8BA4A"/><path d="M41 38h12m-5-5 5 5-5 5"/></>}
    {category === 'check' && <><circle cx="32" cy="32" r="20" fill="#FFFDF5"/><path d="m20 32 8 8 17-19" stroke-width="3"/><path d="m49 12 3-5m1 12 6-1" stroke="#AC7A20"/></>}
    {category === 'spark' && <><path d="m31 11 5 15 16 6-16 6-5 15-6-15-15-6 15-6 6-15Z" fill="#FFFDF5"/><path d="m50 9 2 6 6 2-6 2-2 6-2-6-6-2 6-2 2-6Z" fill="#E8BA4A"/><path d="m13 46 2 5 5 2-5 2-2 5-2-5-5-2 5-2 2-5Z" fill="#E8BA4A"/></>}
    {category === 'pause' && <><circle cx="32" cy="32" r="21" fill="#FFFDF5"/><rect x="23" y="22" width="6" height="20" rx="2" fill="#E8BA4A"/><rect x="36" y="22" width="6" height="20" rx="2" fill="#E8BA4A"/></>}
    {!['accounting','banking','payment','reservation','line','website','google','instagram','crm','shop','concept','target','calendar','document','mail','megaphone','chart','people','compass','salon','school','visiting','check','spark','pause'].includes(category) && <><path d="M17 16h30v37H17z" fill="#FFFDF5"/><path d="M25 13h14v7H25z" fill="#E8BA4A"/><path d="m23 31 3 3 5-6m-8 16 3 3 5-6m5-10h5m-5 13h5"/></>}
  </g>
</svg>}
<style>.tool-glyph{display:block;flex-shrink:0;max-width:100%;height:auto}</style>
