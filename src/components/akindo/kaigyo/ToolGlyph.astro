    {!['accounting','banking','payment','reservation','line','website','google','instagram','crm','shop'].includes(category) && <><path d="M17 16h30v37H17z" fill="#FFFDF5"/><path d="M25 13h14v7H25z" fill="#E8BA4A"/><path d="m23 31 3 3 5-6m-8 16 3 3 5-6m5-10h5m-5 13h5"/></>}
