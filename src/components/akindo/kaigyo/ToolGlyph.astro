    {category === 'website' && <><rect x="10" y="14" width="44" height="35" rx="4" fill="#FFFDF5"/><path d="M10 24h44M16 19h1m5 0h1m5 0h1"/><path d="M16 30h16v12H16z" fill="#E8BA4A"/><path d="M38 31h9m-9 6h9m-31 17h31M27 49v5m10-5v5"/></>}
    {category === 'google' && <><path d="m10 25 14-5 16 5 14-5v29l-14 5-16-5-14 5V25Z" fill="#FFFDF5"/><path d="M24 36v13m16-11v16M11 42l13-6 16 6 13-7" stroke="#91A58B"/><path d="M43 21c0 8-11 17-11 17S21 29 21 21a11 11 0 0 1 22 0Z" fill="#E8BA4A"/><circle cx="32" cy="21" r="4"/></>}
    {category === 'instagram' && <><rect x="17" y="9" width="30" height="46" rx="6" fill="#FFFDF5"/><path d="M28 15h8M29 49h6"/><rect x="22" y="21" width="20" height="18" rx="2" fill="#E8BA4A"/><circle cx="28" cy="27" r="2"/><path d="m23 36 6-5 4 3 5-6 4 7M22 44h11m5 0h3"/></>}
    {category === 'crm' && <><path d="M13 16h15l5 5h19v29H13V16Z" fill="#FFFDF5"/><path d="M17 13h28v8"/><circle cx="27" cy="32" r="5" fill="#E8BA4A"/><path d="M18 44c1-8 17-8 18 0m3-13h7m-7 6h7m-7 6h5"/></>}
