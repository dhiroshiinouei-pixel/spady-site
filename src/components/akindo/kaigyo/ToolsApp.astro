---
import { toolCategories, tools } from '../../../data/akindo/tools';
import ToolGlyph from './ToolGlyph.astro';
const visibleTools = tools.filter(tool => tool.status !== 'draft');
const difficultyLabels = {easy:'基本の設定から',medium:'設定と動作確認が必要',advanced:'専門的な設定が必要'};
---
<section class="tools-app" aria-labelledby="catalog-heading" data-tools-app>
  <div class="catalog-heading"><div><p class="k-eyebrow">TOOL BOX</p><h2 id="catalog-heading">何を整えたいですか？</h2></div><p class="catalog-count" aria-live="polite" aria-atomic="true" data-tool-count>{visibleTools.length}件の選択肢</p></div>
  <div class="tool-filters" role="group" aria-label="道具のカテゴリで絞り込む" data-tool-filters hidden>
    <button type="button" class="all-categories" data-category="all" aria-pressed="true"><span class="all-mark" aria-hidden="true">＋</span><span>すべて見る</span></button>
    {toolCategories.map(category => <button type="button" data-category={category.id} aria-pressed="false"><ToolGlyph category={category.id} size={38}/><span>{category.id === 'shop' ? <><span class="k-phrase">ネット</span><span class="k-phrase">ショップ</span></> : category.name}</span></button>)}
  </div>
  <noscript><p class="k-muted">すべてのカテゴリを表示しています。ページ内検索でも道具を探せます。</p></noscript>
  <p class="filter-context" data-filter-context>機能の数より、自分が使い続けられるかを確かめましょう。</p>
  <div class="tool-results">
    {visibleTools.map(tool => {
      const category = toolCategories.find(item => item.id === tool.category)!;
      return <article id={tool.slug} class="k-card tool-result" data-tool-category={tool.category}>
        <div class="tool-card-top"><div><span class="tool-category-label">{category.name}</span><h3>{tool.name}</h3></div><ToolGlyph category={category.id} size={66}/></div>
        <p class="tool-description">{tool.shortDescription}</p>
        <dl class="tool-facts">
          <div><dt><ToolGlyph category="people" size={24}/><span>こんな方に</span></dt><dd>{tool.bestFor[0]}</dd></div>
          <div><dt><ToolGlyph category="calendar" size={24}/><span>始めどき</span></dt><dd>{tool.timing}</dd></div>
        </dl>
        <details class="tool-detail"><summary>向き・不向きと、設定の目安<span aria-hidden="true">＋</span></summary><div>
          {tool.bestFor.length > 1 && <><h4>ほかにも、こんな使い方に</h4><ul>{tool.bestFor.slice(1).map(item => <li>{item}</li>)}</ul></>}
          <h4>急いで入れなくてもよい方</h4><ul>{tool.notFor.map(item => <li>{item}</li>)}</ul>
          <h4>設定の目安</h4><p>{difficultyLabels[tool.difficulty]}</p>
          {tool.lastVerified ? <p class="tool-verification">公式URL確認：<time datetime={tool.lastVerified}>{tool.lastVerified.replaceAll('-', '.')}</time>{tool.status === 'checking' ? '（詳細機能は確認中）' : ''}</p> : <p class="tool-verification">特定のサービスへのリンクは掲載していません。</p>}
        </div></details>
        <div class="tool-bottom"><p class="tool-pricing">{tool.pricingNote}</p>
          <div class="tool-actions">{tool.affiliateUrl ? <a class="tool-official" href={tool.affiliateUrl} rel="sponsored nofollow">広告リンクで詳細を見る <span aria-hidden="true">↗</span></a> : tool.officialUrl ? <a class="tool-official" href={tool.officialUrl}>公式サイトで確認 <span aria-hidden="true">↗</span></a> : <span class="tool-no-link">個別サービスの情報は確認中</span>}
            {tool.affiliateUrl && tool.officialUrl && <a class="k-link" href={tool.officialUrl}>公式サイト</a>}
          </div>
          {tool.status === 'checking' && <span class="checking-tag">一部の情報は確認中</span>}
        </div>
      </article>;
    })}
  </div>
</section>
<script>
  import { toolCategories } from '../../../data/akindo/tools';
  const app = document.querySelector<HTMLElement>('[data-tools-app]');
  if (app) {
    const toolbar = app.querySelector<HTMLElement>('[data-tool-filters]');
    const buttons = Array.from(app.querySelectorAll<HTMLButtonElement>('[data-category]'));
    const cards = Array.from(app.querySelectorAll<HTMLElement>('[data-tool-category]'));
    const count = app.querySelector<HTMLElement>('[data-tool-count]');
    const context = app.querySelector<HTMLElement>('[data-filter-context]');
    const isValid = (id: string) => id === 'all' || toolCategories.some(category => category.id === id);
    function filter(category: string, updateUrl = false) {
      const selected = isValid(category) ? category : 'all';
      let shown = 0;
      cards.forEach(card => { card.hidden = selected !== 'all' && card.dataset.toolCategory !== selected; if (!card.hidden) shown++; });
      buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.category === selected)));
      const details = toolCategories.find(item => item.id === selected);
      if (count) count.textContent = `${details ? details.name + '：' : ''}${shown}件の選択肢`;
      if (context) context.textContent = details ? `${details.description} ${details.bestFor}に。始めどき：${details.timing}。` : '機能の数より、自分が使い続けられるかを確かめましょう。';
      if (updateUrl) {
        const url = new URL(window.location.href);
        if (selected === 'all') url.searchParams.delete('category'); else url.searchParams.set('category', selected);
        url.hash = '';
        try { window.history.replaceState(null, '', url); } catch { /* Filtering still works if the host disallows history changes. */ }
      }
    }
    function fromUrl() {
      const url = new URL(window.location.href);
      const target = cards.find(card => `#${card.id}` === url.hash);
      filter(target?.dataset.toolCategory ?? url.searchParams.get('category') ?? 'all');
      if (target) target.scrollIntoView({ block: 'start', behavior: 'instant' });
    }
    buttons.forEach(button => button.addEventListener('click', () => filter(button.dataset.category ?? 'all', true)));
    toolbar?.removeAttribute('hidden');
    fromUrl();
    window.addEventListener('popstate', fromUrl);
    window.addEventListener('hashchange', fromUrl);
  }
</script>
<style>
  .catalog-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin:0 0 22px}.catalog-heading .k-eyebrow{margin-bottom:6px}.catalog-heading h2{margin:0;font-size:clamp(1.5rem,3vw,2.1rem);letter-spacing:-.035em}.catalog-count{color:var(--color-text-muted);font-size:.85rem;flex-shrink:0}.tool-filters{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px}.tool-filters[hidden]{display:none}.tool-filters button{display:flex;align-items:center;justify-content:flex-start;gap:8px;min-height:66px;padding:10px;border:1px solid var(--color-border);border-radius:13px;background:var(--color-surface);color:var(--color-text);font:inherit;font-size:.78rem;font-weight:700;cursor:pointer;line-height:1.5}.tool-filters button>span{min-width:0;overflow-wrap:anywhere}.tool-filters button[aria-pressed=true]{background:#294c3b;color:white;border-color:#294c3b;box-shadow:0 0 0 1px #294c3b}.tool-filters button:hover{border-color:#294c3b}.all-mark{display:grid;place-items:center;width:38px;flex-shrink:0;font-size:29px;font-weight:400}.filter-context{font-size:.87rem;line-height:1.8;color:var(--color-text-muted);margin:20px 0 26px;padding-left:13px;border-left:3px solid var(--color-brand)}.tool-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;align-items:start}.tool-result{display:flex;flex-direction:column;padding:28px;scroll-margin-top:120px;min-width:0}.tool-result[hidden]{display:none}.tool-card-top{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:16px}.tool-card-top>div{min-width:0}.tool-category-label{font-size:.76rem;font-weight:700;color:var(--color-brand-dark)}.checking-tag{font-size:.75rem;font-weight:700;color:var(--color-text-muted);display:block;margin-top:10px}.tool-result h3{font-size:1.22rem;line-height:1.6;margin:5px 0 0;letter-spacing:-.025em;overflow-wrap:anywhere}.tool-description{line-height:1.9;margin:0 0 18px;font-size:.9rem;color:var(--color-text-muted)}.tool-facts{margin:0 0 16px;background:#f7f6ee;border-radius:12px;padding:4px 15px}.tool-facts>div{padding:11px 0;display:grid;grid-template-columns:76px minmax(0,1fr);gap:10px}.tool-facts>div+div{border-top:1px solid var(--color-border)}.tool-facts dt{font-size:.75rem;font-weight:700;color:var(--color-text-muted);line-height:1.9}.tool-facts dd{font-size:.83rem;line-height:1.9;margin:0}.tool-detail{border-block:1px solid var(--color-border)}.tool-detail summary{display:flex;justify-content:space-between;gap:12px;align-items:center;min-height:48px;cursor:pointer;list-style:none;font-size:.81rem;font-weight:700}.tool-detail summary::-webkit-details-marker{display:none}.tool-detail summary>span{font-size:18px;transition:transform .2s}.tool-detail[open] summary>span{transform:rotate(45deg)}.tool-detail>div{padding:0 0 18px}.tool-detail h4{font-size:.78rem;margin:14px 0 5px;color:var(--color-text-muted)}.tool-detail ul{padding-left:1.2em;margin:0;font-size:.82rem;line-height:1.9}.tool-detail p{font-size:.82rem;line-height:1.9;margin:0}.tool-detail .tool-verification{font-size:.74rem;color:var(--color-text-muted);margin-top:14px}.tool-bottom{margin-top:auto;padding-top:17px}.tool-pricing{font-size:.75rem;line-height:1.8;color:var(--color-text-muted);margin:0 0 14px}.tool-actions{display:flex;flex-wrap:wrap;gap:12px}.tool-official{width:100%;display:flex;justify-content:space-between;align-items:center;gap:10px;min-height:47px;padding:10px 16px;border:1px solid #bdc8b5;border-radius:10px;text-decoration:none;font-size:.85rem;font-weight:700;color:#294c3b;background:#f2f5ec}.tool-official:hover{background:#e4ebdc;border-color:#294c3b}.tool-no-link{font-size:.8rem;line-height:1.8;color:var(--color-text-muted);font-weight:700;min-height:47px;display:flex;align-items:center}@media(min-width:1200px){.tool-results{grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.tool-result{padding:24px}.tool-filters{grid-template-columns:repeat(6,minmax(0,1fr))}.tool-facts>div{grid-template-columns:68px minmax(0,1fr);gap:7px}.tool-card-top{gap:10px}.tool-card-top :global(.tool-glyph){width:58px}}@media(max-width:1000px){.tool-filters{grid-template-columns:repeat(4,minmax(0,1fr))}}@media(max-width:650px){.catalog-heading{display:block;margin-bottom:18px}.catalog-count{margin-top:8px}.tool-filters{grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}.tool-filters button{min-height:80px;flex-direction:column;justify-content:center;gap:5px;padding:8px 5px;font-size:.74rem}.tool-filters button :global(.tool-glyph){width:32px}.all-mark{width:32px;height:32px;font-size:27px}.tool-results{grid-template-columns:1fr;gap:16px}.tool-result{padding:23px}.tool-result h3{font-size:1.25rem}.tool-facts>div{grid-template-columns:70px minmax(0,1fr)}.tool-description{font-size:.9rem}.filter-context{font-size:.82rem;margin-block:18px 24px}}

  .tool-facts dt{display:flex;flex-direction:column;align-items:flex-start;gap:4px}.tool-facts>div{align-items:center}.tool-facts dt :global(.tool-glyph){width:25px}.tool-facts dd{padding-block:3px}
</style>
