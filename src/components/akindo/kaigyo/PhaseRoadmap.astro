---
import PreparationSketch from './PreparationSketch.astro';
const roadmap = [
  {label:'商いを決める', items:['誰に何を提供するか','屋号・価格','開業予定日']},
  {label:'手続きとお金',items:['開業届・事業用口座','会計','保険・許認可の確認']},
  {label:'売る準備',items:['決済・予約','電話・メール','顧客管理']},
  {label:'見つけてもらう準備',items:['Google・Instagram','LINE','ホームページ']},
  {label:'開業を知らせる',items:['告知・初回キャンペーン','口コミ・広告','リピート導線']},
];
---
<section class="k-section k-roadmap-wrap" aria-labelledby="roadmap-title"><div class="k-container"><div class="k-section-heading"><div><p class="k-eyebrow">THE ROAD TO OPENING</p><h2 id="roadmap-title"><span class="k-phrase">開業までの道のりを、</span><span class="k-phrase">見える化。</span></h2><p>何から手をつけるか迷わないように、開業準備を5つの段階に整理しました。</p></div><a class="k-link" href="/akindo/kaigyo/checklist/">やることを確認する <span aria-hidden="true">→</span></a></div><ol class="k-roadmap">{roadmap.map((p,i)=><li><div class="roadmap-art"><span class="k-roadmap-number">0{i+1}</span><PreparationSketch kind={(['plan','finance','shop','discovery','announce'] as const)[i]}/></div><h3>{p.label}</h3><ul>{p.items.map(item=><li>{item}</li>)}</ul></li>)}</ol><p class="k-roadmap-note">業種や準備状況に応じて順番は前後します。必要な項目から進め、開業後も見直していきましょう。</p></div></section>

<style>.roadmap-art{display:flex;flex-direction:column;align-items:center;gap:16px;margin-bottom:16px}.k-roadmap-number{font-size:13px;border-radius:50%;background:var(--color-accent);color:#fff;width:30px;height:30px;display:grid;place-items:center;margin:0}.k-roadmap>li{padding:22px 16px;background:transparent;border:0}.k-roadmap>li:not(:last-child):after{background:none;color:var(--color-accent);top:96px;font-size:22px;right:-19px}.k-roadmap h3{text-align:center;font-size:16px}.k-roadmap ul{text-align:center;font-size:12px}.k-roadmap>li:first-child .k-roadmap-number{background:var(--color-brand);color:var(--color-text)}@media(max-width:767px){.k-roadmap{gap:0}.k-roadmap>li{grid-template-columns:94px 1fr;gap:0 18px;align-items:center;padding:16px 0;border-bottom:1px solid #d0d9c7;border-radius:0}.roadmap-art{grid-row:1/3;position:relative;margin:0;padding-top:7px}.roadmap-art :global(svg){width:90px;height:70px}.k-roadmap-number{position:absolute;top:0;left:0;width:24px;height:24px;font-size:10px}.k-roadmap h3,.k-roadmap ul{text-align:left}.k-roadmap h3{align-self:end;font-size:18px}.k-roadmap ul{align-self:start;display:block;font-size:12px}.k-roadmap>li:not(:last-child):after{display:none}}</style>
