---
import { industries } from '../../../data/akindo/industries';
const salon = industries[0];
---
<section class="k-section k-industries" id="industries" aria-labelledby="industries-title"><div class="k-container">
<div class="k-section-heading"><div><p class="k-eyebrow">FOR YOUR BUSINESS</p><h2 id="industries-title"><span class="k-phrase">あなたの商いに合わせて</span><span class="k-phrase">準備する</span></h2><p>お客さまとの出会い方も、必要な道具も、商いごとに違います。</p></div></div>
<div class="industry-editorial"><a class="industry-feature" href={salon.href}><img src="/akindo/kaigyo-assets/illustrations/salon-scene-v2.webp" srcset="/akindo/kaigyo-assets/illustrations/salon-scene-v2-640.webp 640w, /akindo/kaigyo-assets/illustrations/salon-scene-v2.webp 1200w" sizes="(max-width:767px) calc(100vw - 40px),50vw" width="1200" height="800" loading="lazy" alt="小さなサロンで、お客さまの話に耳を傾けるオーナーのイラスト"/><div><span class="k-tag">はじめての開業ガイド</span><h3>{salon.name}</h3><p>{salon.description}</p><span class="k-link">ひとりサロンの準備を見る <span aria-hidden="true">→</span></span></div></a>
<div class="industry-others"><p class="industry-others-intro">こんな商いも、共通リストから始められます。</p>{industries.slice(1).map(industry=><a href={industry.href}><div><h3>{industry.name}</h3><p>{industry.description}</p><small>個別ガイド準備中 · 共通チェックリストへ</small></div><span aria-hidden="true">→</span></a>)}</div></div>
</div></section>
<style>.industry-editorial{display:grid;grid-template-columns:1fr 1fr;gap:48px}.industry-feature{overflow:hidden;border:1px solid var(--color-border);border-radius:24px;background:var(--color-background)}.industry-feature>img{width:100%;aspect-ratio:3/2;object-fit:cover}.industry-feature>div{padding:25px 30px}.industry-feature h3{font-size:28px;margin:12px 0 8px}.industry-feature p{color:var(--color-text-muted);font-size:14px}.industry-feature .k-link{margin-top:12px}.industry-feature:hover{border-color:var(--color-accent)}.industry-others-intro{font-size:13px;margin-bottom:8px;color:var(--color-text-muted)}.industry-others>a{display:flex;align-items:center;gap:18px;justify-content:space-between;border-bottom:1px solid var(--color-border);padding:18px 0}.industry-others h3{font-size:18px}.industry-others a p{font-size:13px;margin-top:4px}.industry-others small{display:block;color:var(--color-text-muted);font-size:10px;margin-top:6px}.industry-others>a>span{width:32px;height:32px;display:grid;place-items:center;background:var(--color-background);border-radius:50%;flex-shrink:0}.industry-others a:hover h3{text-decoration:underline;text-underline-offset:4px}@media(max-width:767px){.industry-editorial{grid-template-columns:1fr;gap:26px}.industry-feature>div{padding:22px}.industry-feature h3{font-size:24px}.industry-others>a{padding:16px 0}}</style>
