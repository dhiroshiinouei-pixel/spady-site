---
import '../styles/home.css';
import '../styles/motion.css';
import SiteConsent from '../components/SiteConsent.astro';
const {title='Spady｜地域の魅力に、次のきっかけを。',description='小樽・銭函を拠点に、マーケティングとテクノロジーで商いと暮らしのつながるをつくる。Spadyの事業、サービス、地域での活動をご紹介します。',noindex=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,'https://spady.net').href;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" /><meta property="og:site_name" content="Spady" />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} /><meta property="og:locale" content="ja_JP" />
  <meta property="og:image" content="https://spady.net/home/coastal-neighborhood.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <script is:inline>try{if(localStorage.getItem('spady_motion')==='paused')document.documentElement.dataset.motion='paused';}catch{}</script>
</head>
<body>
  <a class="skip-link" href="#main">本文へ移動</a>
  <div class="scroll-progress" aria-hidden="true"></div><div class="scroll-aura" aria-hidden="true"></div>
    <header class="home-header">
      <a class="brand" href="/" aria-label="Spady ホーム"><img src="/logo.png" width="68" height="68" alt="Spady" /><span>地域と、ともに。</span></a>
      <nav class="desktop-nav" aria-label="メインナビゲーション"><a href="/#about">Spadyについて</a><a href="/#projects">事業・プロジェクト</a><a href="/#stories">実績・活動</a><a class="nav-contact" href="/contact/">お問い合わせ <span aria-hidden="true">↗</span></a></nav>
      <details class="mobile-menu"><summary aria-label="メニュー"><span></span><span></span></summary><nav aria-label="モバイルナビゲーション"><a href="/#about">Spadyについて <span aria-hidden="true">↗</span></a><a href="/#projects">事業・プロジェクト <span aria-hidden="true">↗</span></a><a href="/#stories">実績・活動 <span aria-hidden="true">↗</span></a><a href="/contact/">お問い合わせ <span aria-hidden="true">↗</span></a></nav></details>
    </header>
<slot />
    <footer class="home-footer section-shell"><div class="footer-main"><div class="footer-brand"><a href="/" aria-label="Spady ホーム"><img src="/logo.png" width="78" height="78" alt="Spady" /></a><p>地域の魅力に、次のきっかけを。<span>北海道小樽市銭函</span></p></div><div class="footer-nav"><a href="/#about">Spadyについて</a><a href="/#projects">事業・プロジェクト</a><a href="/#stories">実績・活動</a><a href="https://www.threads.com/@hiroshiinoue.spady">Threads ↗</a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Spady</span><a href="/privacy/">プライバシーポリシー</a><a href="#main">PAGE TOP ↑</a></div></footer>

  <button class="motion-control" type="button" aria-pressed="false" aria-label="動きを停止"><span class="motion-symbol" aria-hidden="true">Ⅱ</span><span class="motion-label">動きを停止</span></button>
  <SiteConsent />
  <script>import '../scripts/home-motion';</script>
</body></html>
